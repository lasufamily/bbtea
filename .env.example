# ─────────────────────────────────────────
# Airtable (required — build will fail without these)
# ─────────────────────────────────────────
# Create a Personal Access Token at: https://airtable.com/create/tokens
# Scopes needed: data.records:read, schema.bases:read
AIRTABLE_API_KEY=patXXXXXXXXXXXXXX.XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Found in your Airtable base URL: airtable.com/{BASE_ID}/...
AIRTABLE_BASE_ID=appXXXXXXXXXXXXXX

# ─────────────────────────────────────────
# Site
# ─────────────────────────────────────────
# Public site URL (no trailing slash)
SITE_URL=https://bbtea.sg

# ─────────────────────────────────────────
# Google Search Console (optional — needed for scripts/gsc-performance.mjs)
# ─────────────────────────────────────────
# Create an OAuth client in Google Cloud Console and paste the values here.
GSC_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GSC_CLIENT_SECRET=your-google-oauth-client-secret

# Optional overrides
# GSC_SITE_URL=https://bbtea.sg/
# GSC_TOKEN_FILE=/absolute/path/to/token.json
