# ─────────────────────────────────────────
# Airtable (required — build will fail without these)
# ─────────────────────────────────────────
# Create a Personal Access Token at: https://airtable.com/create/tokens
# Scopes needed: data.records:read, schema.bases:read
AIRTABLE_API_KEY=patXXXXXXXXXXXXXX.XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Found in your Airtable base URL: airtable.com/{BASE_ID}/...
AIRTABLE_BASE_ID=appXXXXXXXXXXXXXX

# ─────────────────────────────────────────
# Site
# ─────────────────────────────────────────
# Public site URL (no trailing slash)
SITE_URL=https://bbtea.sg
