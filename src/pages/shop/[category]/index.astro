---
import Layout from '../../../components/Layout.astro';
import ShopProductBrowser from '../../../components/ShopProductBrowser.astro';
import { getProducts } from '../../../lib/airtable';
import type { Product } from '../../../lib/types';

export async function getStaticPaths() {
  const products = await getProducts();
  const byCategory = new Map<string, { name: string; slug: string; products: Product[] }>();

  for (const product of products) {
    const existing = byCategory.get(product.categorySlug);
    if (existing) {
      existing.products.push(product);
    } else {
      byCategory.set(product.categorySlug, {
        name: product.category,
        slug: product.categorySlug,
        products: [product],
      });
    }
  }

  const categoryButtons = Array.from(byCategory.values())
    .map(({ name, slug }) => ({ name, slug }))
    .sort((a, b) => a.name.localeCompare(b.name));

  return Array.from(byCategory.entries()).map(([categorySlug, group]) => ({
    params: { category: categorySlug },
    props: {
      categoryName: group.name,
      categorySlug,
      categoryButtons,
      products: group.products,
    },
  }));
}

interface Props {
  categoryName: string;
  categorySlug: string;
  categoryButtons: { name: string; slug: string }[];
  products: Product[];
}

const { categoryName, categorySlug, categoryButtons, products } = Astro.props;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: `${categoryName} | Shop | BBTea.sg`,
  description: `Browse ${products.length} ${categoryName} picks for bubble tea fans in Singapore.`,
  url: `https://bbtea.sg/shop/${categorySlug}/`,
};
---

<Layout
  title={`${categoryName} | Shop | BBTea.sg`}
  description={`Browse ${products.length} ${categoryName} products curated for bubble tea and everyday drink runs in Singapore.`}
  canonical={`https://bbtea.sg/shop/${categorySlug}/`}
  jsonLd={jsonLd}
>

  <section class="bg-white border-b border-[var(--color-stone-200)] py-16">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 space-y-4" data-pagefind-body>
      <nav class="text-sm text-[var(--color-stone-400)] flex items-center gap-1.5" aria-label="Breadcrumb">
        <a href="/" class="hover:text-[var(--color-forest-700)] transition-colors">Home</a>
        <span>/</span>
        <a href="/shop/" class="hover:text-[var(--color-forest-700)] transition-colors">Shop</a>
        <span>/</span>
        <span class="text-[var(--color-stone-700)] font-medium">{categoryName}</span>
      </nav>
      <p class="text-xs font-semibold tracking-[0.2em] uppercase text-[var(--color-forest-700)]">
        Shop category
      </p>
      <h1 class="text-3xl lg:text-5xl font-display font-bold leading-tight">
        {categoryName}
      </h1>
      <div class="flex flex-wrap gap-3 pt-2">
        <a
          href="/shop/"
          class="inline-flex items-center justify-center rounded-md border border-[var(--color-stone-200)] bg-white px-4 py-2.5 text-sm font-semibold text-[var(--color-stone-800)] shadow-sm transition-colors hover:border-[var(--color-forest-700)] hover:text-[var(--color-forest-700)]"
        >
          All Products
        </a>
        {categoryButtons.map(category => (
          <a
            href={`/shop/${category.slug}/`}
            aria-current={category.slug === categorySlug ? 'page' : undefined}
            class:list={[
              'inline-flex items-center justify-center rounded-md border px-4 py-2.5 text-sm font-semibold shadow-sm transition-colors',
              category.slug === categorySlug
                ? 'border-[var(--color-forest-700)] bg-[var(--color-forest-700)] text-white'
                : 'border-[var(--color-stone-200)] bg-white text-[var(--color-stone-800)] hover:border-[var(--color-forest-700)] hover:text-[var(--color-forest-700)]',
            ]}
          >
            {category.name}
          </a>
        ))}
      </div>
    </div>
  </section>

  <ShopProductBrowser
    products={products}
    showCategoryFilter={false}
    pagePath={`/shop/${categorySlug}/`}
  />

</Layout>
