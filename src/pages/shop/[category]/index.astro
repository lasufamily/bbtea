---
import Layout from '../../../components/Layout.astro';
import ProductCard from '../../../components/ProductCard.astro';
import { getProducts } from '../../../lib/airtable';
import type { Product } from '../../../lib/types';

export async function getStaticPaths() {
  const products = await getProducts();
  const byCategory = new Map<string, { name: string; products: Product[] }>();

  for (const product of products) {
    const existing = byCategory.get(product.categorySlug);
    if (existing) {
      existing.products.push(product);
    } else {
      byCategory.set(product.categorySlug, {
        name: product.category,
        products: [product],
      });
    }
  }

  return Array.from(byCategory.entries()).map(([categorySlug, group]) => ({
    params: { category: categorySlug },
    props: {
      categoryName: group.name,
      categorySlug,
      products: group.products,
    },
  }));
}

interface Props {
  categoryName: string;
  categorySlug: string;
  products: Product[];
}

const { categoryName, categorySlug, products } = Astro.props;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: `${categoryName} | Shop | BBTea.sg`,
  description: `Browse ${products.length} ${categoryName} picks for bubble tea fans in Singapore.`,
  url: `https://bbtea.sg/shop/${categorySlug}/`,
};
---

<Layout
  title={`${categoryName} | Shop | BBTea.sg`}
  description={`Browse ${products.length} ${categoryName} products curated for bubble tea and everyday drink runs in Singapore.`}
  canonical={`https://bbtea.sg/shop/${categorySlug}/`}
  jsonLd={jsonLd}
>

  <section class="bg-white border-b border-[var(--color-stone-200)] py-16">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 space-y-4" data-pagefind-body>
      <nav class="text-sm text-[var(--color-stone-400)] flex items-center gap-1.5" aria-label="Breadcrumb">
        <a href="/" class="hover:text-[var(--color-forest-700)] transition-colors">Home</a>
        <span>/</span>
        <a href="/shop/" class="hover:text-[var(--color-forest-700)] transition-colors">Shop</a>
        <span>/</span>
        <span class="text-[var(--color-stone-700)] font-medium">{categoryName}</span>
      </nav>
      <p class="text-xs font-semibold tracking-[0.2em] uppercase text-[var(--color-forest-700)]">
        Shop category
      </p>
      <h1 class="text-3xl lg:text-5xl font-display font-bold leading-tight">
        {categoryName}
      </h1>
      <p class="text-[var(--color-stone-600)] text-base max-w-2xl leading-relaxed">
        {products.length} {products.length === 1 ? 'product' : 'products'} in {categoryName}.
      </p>
    </div>
  </section>

  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14">
    {products.length > 0 ? (
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-5">
        {products.map(product => <ProductCard product={product} />)}
      </div>
    ) : (
      <div class="text-center py-20 space-y-4">
        <p class="text-sm font-semibold tracking-[0.2em] uppercase text-[var(--color-stone-400)]">No Results</p>
        <h2 class="text-xl font-display font-semibold text-[var(--color-stone-800)]">No products in this category</h2>
        <a href="/shop/" class="text-[var(--color-forest-700)] font-medium hover:underline">Browse all shop items</a>
      </div>
    )}
  </section>

</Layout>
