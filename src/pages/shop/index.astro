---
import Layout from '../../components/Layout.astro';
import ShopProductBrowser from '../../components/ShopProductBrowser.astro';
import { getProducts } from '../../lib/airtable';

const products = await getProducts();
const categoryButtons = Array.from(
  products.reduce((categories, product) => {
    if (!categories.has(product.categorySlug)) {
      categories.set(product.categorySlug, {
        name: product.category,
        slug: product.categorySlug,
      });
    }
    return categories;
  }, new Map<string, { name: string; slug: string }>())
  .values(),
).sort((a, b) => a.name.localeCompare(b.name));

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Shop bubble tea gear in Singapore',
  description: 'Browse thermos flasks, tumblers, water bottles, and more picks for bubble tea fans in Singapore.',
  url: 'https://bbtea.sg/shop/',
};
---

<Layout
  title="Shop | Bubble Tea Gear in Singapore | BBTea.sg"
  description="Browse curated bubble tea gear and drinkware in Singapore — water bottles, tumblers, thermos flasks, and more."
  canonical="https://bbtea.sg/shop/"
  jsonLd={jsonLd}
>

  <section class="bg-white border-b border-[var(--color-stone-200)] py-16">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 space-y-4" data-pagefind-body>
      <nav class="text-sm text-[var(--color-stone-400)] flex items-center gap-1.5" aria-label="Breadcrumb">
        <a href="/" class="hover:text-[var(--color-forest-700)] transition-colors">Home</a>
        <span>/</span>
        <span class="text-[var(--color-stone-700)] font-medium">Shop</span>
      </nav>
      <p class="text-xs font-semibold tracking-[0.2em] uppercase text-[var(--color-forest-700)]">
        Curated picks
      </p>
      <h1 class="text-3xl lg:text-5xl font-display font-bold leading-tight">
        Shop
      </h1>
      <div class="flex flex-wrap gap-3 pt-2">
        <a
          href="/shop/"
          aria-current="page"
          class="inline-flex items-center justify-center rounded-md border border-[var(--color-forest-700)] bg-[var(--color-forest-700)] px-4 py-2.5 text-sm font-semibold text-white shadow-sm transition-colors"
        >
          All Products
        </a>
        {categoryButtons.map(category => (
          <a
            href={`/shop/${category.slug}/`}
            class="inline-flex items-center justify-center rounded-md border border-[var(--color-stone-200)] bg-white px-4 py-2.5 text-sm font-semibold text-[var(--color-stone-800)] shadow-sm transition-colors hover:border-[var(--color-forest-700)] hover:text-[var(--color-forest-700)]"
          >
            {category.name}
          </a>
        ))}
      </div>
    </div>
  </section>

  <ShopProductBrowser products={products} showCategoryFilter={true} pagePath="/shop/" />

</Layout>
