---
import Layout from '../components/Layout.astro';

const formEmbedUrl = 'https://airtable.com/embed/appDx02VjVHFsHlAj/shrfpUJtJqEzOYr0h';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  name: 'Advertise with BBTea.sg',
  description: 'Advertise on BBTea.sg to reach bubble tea fans and F&B audiences in Singapore.',
  url: 'https://bbtea.sg/advertise/',
};
---

<Layout
  title="Advertise with BBTea.sg | Reach Bubble Tea Fans in Singapore"
  description="Advertise on BBTea.sg to reach people discovering bubble tea shops, brands, drinks, malls, and neighbourhoods across Singapore."
  canonical="https://bbtea.sg/advertise/"
  jsonLd={jsonLd}
>

  <section class="bg-white border-b border-[var(--color-stone-200)] py-16">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 space-y-6">
      <nav class="text-sm text-[var(--color-stone-400)] flex items-center gap-1.5" aria-label="Breadcrumb">
        <a href="/" class="hover:text-[var(--color-stone-900)] transition-colors">Home</a>
        <span>/</span>
        <span class="text-[var(--color-stone-700)] font-medium">Advertise</span>
      </nav>

      <div class="space-y-5 max-w-3xl">
        <p class="text-xs font-semibold tracking-[0.2em] uppercase text-[var(--color-forest-700)]">
          Advertise with us
        </p>
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-display font-bold leading-tight text-balance">
          Reach people looking for bubble tea in Singapore.
        </h1>
        <p class="text-base lg:text-lg text-[var(--color-stone-600)] leading-relaxed">
          BBTea.sg helps readers discover bubble tea shops by brand, town, MRT station, mall, drink, and dietary preference.
          Tell us what you would like to promote and we will get back to you.
        </p>
      </div>
    </div>
  </section>

  <section class="py-14 lg:py-16">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-[0.8fr_1.2fr] gap-10 lg:gap-14 items-start">
        <aside class="space-y-8">
          <div class="space-y-3">
            <h2 class="text-2xl font-display font-bold text-[var(--color-stone-900)]">
              Good fit for
            </h2>
            <ul class="space-y-3 text-sm text-[var(--color-stone-600)]">
              <li class="flex gap-3">
                <span class="mt-2 h-1.5 w-1.5 rounded-full bg-[var(--color-forest-700)] shrink-0"></span>
                Bubble tea brands launching new outlets, menus, or seasonal drinks
              </li>
              <li class="flex gap-3">
                <span class="mt-2 h-1.5 w-1.5 rounded-full bg-[var(--color-forest-700)] shrink-0"></span>
                Malls, landlords, and F&B groups promoting tenant discovery
              </li>
              <li class="flex gap-3">
                <span class="mt-2 h-1.5 w-1.5 rounded-full bg-[var(--color-forest-700)] shrink-0"></span>
                Agencies planning Singapore food, beverage, or youth lifestyle campaigns
              </li>
            </ul>
          </div>

          <div class="border border-[var(--color-stone-200)] rounded-lg p-5 space-y-2 bg-[var(--color-cream-100)]">
            <h2 class="text-base font-semibold text-[var(--color-stone-900)]">
              Prefer email?
            </h2>
            <p class="text-sm text-[var(--color-stone-600)]">
              You can also reach us directly at
              <a href="mailto:hello@bbtea.sg" class="text-[var(--color-forest-700)] underline hover:text-[var(--color-forest-800)] transition-colors">hello@bbtea.sg</a>.
            </p>
          </div>
        </aside>

        <div class="border border-[var(--color-stone-200)] rounded-lg overflow-hidden bg-white">
          <iframe
            class="airtable-embed block w-full"
            src={formEmbedUrl}
            title="Advertise with BBTea.sg inquiry form"
            frameborder="0"
            width="100%"
            height="1900"
            loading="lazy"
            style="background: transparent;"
          ></iframe>
        </div>
      </div>
    </div>
  </section>

</Layout>
