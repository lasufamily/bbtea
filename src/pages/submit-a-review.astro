---
import Layout from '../components/Layout.astro';
import ExternalForm from '../components/ExternalForm.astro';
---
<Layout title="Submit a Review | BBTea.sg" description="Share a drink review with purchase details and your own photos." canonical="https://bbtea.sg/submit-a-review/" noindex>
  <section class="max-w-4xl mx-auto px-4 py-14 space-y-6">
    <h1 class="text-3xl font-display font-bold">Submit a review</h1>
    <p>Tell us about a drink you bought. Include the outlet, purchase date, size and price, and upload only photos you took or have permission to share. Your review may be published with your chosen display name. Your email is not published.</p>
    <p>Keep comments about the drink and your experience. Do not include another person's private details. Submissions may be edited for clarity, checked or declined; submitting a review does not guarantee publication.</p>
    <ExternalForm provider="fillout" formId="8V2FBhDQkmus" label="Open review form" />
  </section>
</Layout>
