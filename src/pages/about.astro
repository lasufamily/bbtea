    href: 'https://www.threads.com/bbteasg',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4">
      <path d="M12.1 2C7 2 3.8 5.6 3.8 12s3.2 10 8.3 10c4.4 0 7.1-2.3 7.1-5.6 0-2.1-1.1-3.7-3.2-4.6-.3-3.1-1.9-4.8-4.5-4.8-1.7 0-3 .7-3.9 2l1.7 1.2c.5-.7 1.2-1.1 2.2-1.1 1.2 0 2 .7 2.3 2.1-.6-.1-1.2-.1-1.8 0-2.3.2-3.8 1.4-3.7 3.2.1 1.7 1.6 2.8 3.8 2.6 2.1-.2 3.4-1.4 3.8-3.3.8.5 1.2 1.3 1.2 2.4 0 2-1.8 3.5-4.8 3.5-3.9 0-6.2-2.8-6.2-7.6s2.2-7.6 6-7.6c3.5 0 5.5 2.2 5.9 6.3l2.3-.4C19.8 5 16.9 2 12.1 2Zm-.1 12.9c-1 .1-1.5-.2-1.5-.8s.6-1 1.7-1.1c.6 0 1.2 0 1.7.2-.2 1.1-.8 1.6-1.9 1.7Z"/>
    </svg>`,
  },
  {
    label: 'Pinterest',
    href: 'https://www.pinterest.com/bbteasg',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4">
      <path d="M12.017 0C5.396 0 .029 5.367.029 11.987c0 5.079 3.158 9.42 7.618 11.174-.105-.949-.199-2.406.042-3.442.219-.937 1.407-5.965 1.407-5.965s-.359-.72-.359-1.781c0-1.669.967-2.915 2.171-2.915 1.024 0 1.518.769 1.518 1.69 0 1.029-.655 2.568-.994 3.995-.283 1.194.599 2.169 1.777 2.169 2.133 0 3.772-2.249 3.772-5.495 0-2.873-2.064-4.882-5.012-4.882-3.414 0-5.418 2.561-5.418 5.207 0 1.031.397 2.137.893 2.739a.36.36 0 0 1 .083.344c-.091.379-.293 1.194-.333 1.362-.053.22-.174.267-.402.161-1.499-.698-2.436-2.889-2.436-4.649 0-3.785 2.75-7.262 7.929-7.262 4.163 0 7.398 2.967 7.398 6.931 0 4.136-2.607 7.464-6.227 7.464-1.216 0-2.36-.631-2.75-1.378l-.748 2.853c-.271 1.043-1.002 2.35-1.492 3.146A12.017 12.017 0 0 0 12.017 24c6.624 0 11.99-5.367 11.99-11.987C24.007 5.367 18.641.001 12.017.001Z"/>
    </svg>`,
