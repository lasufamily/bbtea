---
import Layout from '../components/Layout.astro';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  name: 'About BBTea.sg',
  description: 'BBTea.sg is an independent guide to bubble tea shops, coffee spots, and cafes across Singapore, from hawker kopi to modern boba brands.',
  url: 'https://bbtea.sg/about/',
  publisher: {
    '@type': 'Organization',
    name: 'BBTea.sg',
    url: 'https://bbtea.sg',
    email: 'hello@bbtea.sg',
  },
};

const categories = [
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" class="w-6 h-6">
