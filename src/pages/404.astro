---
import Layout from '../components/Layout.astro';
---

<Layout
  title="Page Not Found | Bubble Tea SG"
  description="The page you're looking for doesn't exist. Discover Singapore's best bubble tea shops on Bubble Tea SG."
  noindex
>
  <div class="min-h-[70vh] flex flex-col items-center justify-center px-4 py-20 text-center space-y-8">
    <div class="space-y-4">
      <p class="text-8xl">🧋</p>
      <h1 class="text-4xl font-display font-bold text-[var(--color-stone-900)]">
        Whoops, no boba here.
      </h1>
      <p class="text-lg text-[var(--color-stone-500)] max-w-md mx-auto">
        The page you're looking for doesn't exist or has moved. Let's get you back to discovering great bubble tea.
      </p>
    </div>

    <div class="flex flex-col sm:flex-row gap-3">
      <a
        href="/"
        class="px-6 py-3 rounded-full bg-[var(--color-forest-700)] text-white text-sm font-semibold hover:bg-[var(--color-forest-800)] transition-colors"
      >
        Back to Home
      </a>
      <a
        href="/directory"
        class="px-6 py-3 rounded-full border border-[var(--color-stone-200)] text-[var(--color-stone-700)] text-sm font-semibold hover:border-[var(--color-forest-700)] hover:text-[var(--color-forest-700)] transition-colors"
      >
        Browse All Shops
      </a>
    </div>
  </div>
</Layout>
