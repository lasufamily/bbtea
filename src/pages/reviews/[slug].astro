---
import Layout from '../../components/Layout.astro';
import { getBrands, getCoffeeOutlets, getDrinks, getJuiceOutlets, getOutlets, getReviews } from '../../lib/airtable';
import { reviewEntityLinks } from '../../lib/internalLinks';
import { splitArticleParagraphs } from '../../lib/reviews';
import { pathSegment } from '../../lib/url';
import type { Review } from '../../lib/types';

export async function getStaticPaths() {
  const reviews = await getReviews();
  return reviews.map(review => ({
    params: { slug: review.slug },
    props: { review },
  }));
}

interface Props { review: Review }
const { review } = Astro.props;
const [brands, drinks, outlets, coffeeOutlets, juiceOutlets] = await Promise.all([
  getBrands(),
  getDrinks(),
  getOutlets(),
  getCoffeeOutlets(),
  getJuiceOutlets(),
]);

const cupPhoto = review.photos.find(photo => photo.label === 'Cup');
const heroPhoto = cupPhoto ?? review.photos[0];
const articleParagraphs = splitArticleParagraphs(review.article);
const bodyParagraphs = articleParagraphs.slice(1);
const purchaseDate = review.dateOfPurchase
  ? new Date(review.dateOfPurchase).toLocaleDateString('en-SG', { year: 'numeric', month: 'long', day: 'numeric' })
  : 'a recent visit';
const price = typeof review.price === 'number'
  ? new Intl.NumberFormat('en-SG', { style: 'currency', currency: 'SGD' }).format(review.price)
  : undefined;
const reviewSubject = [review.brand, review.drinkName].filter(Boolean).join(' ') || 'Drink';
const locationLabel = review.outletLocation ? ` at ${review.outletLocation}` : '';
const fallbackTitle = `${reviewSubject} Review${locationLabel}`;
const title = review.pageTitle ?? fallbackTitle;
const description = `${articleParagraphs[0] ?? `Read this Singapore drink review by ${review.reviewerName ?? 'a BBTea.sg reader'}.`}`.slice(0, 155);
const byline = review.reviewerName ? `Reviewed by ${review.reviewerName}` : 'Reviewed by a BBTea.sg reader';

const quickFacts = [
  { label: 'Brand', value: review.brand },
  { label: 'Outlet', value: review.outletLocation },
  { label: 'Drink', value: review.drinkName },
  { label: 'Size', value: review.size },
  { label: 'Sugar', value: review.sugarLevel },
  { label: 'Topping', value: review.toppingName },
  { label: 'Price', value: price },
  { label: 'Promo', value: review.promoUsed },
  { label: 'Date bought', value: purchaseDate },
  { label: 'Reviewer', value: review.reviewerName },
].filter((item): item is { label: string; value: string } => Boolean(item.value));
const menuBrandSlugs = new Set(drinks.flatMap(drink => drink.brands.map(brand => brand.slug)));
const entityLinks = reviewEntityLinks({
  reviewBrand: review.brand,
  reviewDrink: review.drinkName,
  reviewOutlet: review.outletLocation,
  brands,
  drinks,
  outlets: [...outlets, ...coffeeOutlets, ...juiceOutlets],
  menuBrandSlugs,
});

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Review',
  name: title,
  itemReviewed: {
    '@type': 'Product',
    name: reviewSubject,
    ...(review.brand && { brand: review.brand }),
  },
  author: {
    '@type': 'Person',
    name: review.reviewerName ?? 'BBTea.sg reader',
  },
  reviewBody: review.article,
  datePublished: review.dateOfPurchase ?? review.createdTime,
  image: review.photos.map(photo => photo.url),
  url: `https://bbtea.sg/reviews/${pathSegment(review.slug)}/`,
};
---

<Layout
  title={title}
  description={description}
  image={heroPhoto?.url}
  type="article"
  canonical={`https://bbtea.sg/reviews/${pathSegment(review.slug)}/`}
  jsonLd={jsonLd}
>
  <article data-pagefind-body>
    <section class="bg-[var(--color-cream-100)] border-b border-[var(--color-stone-200)]">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-10 lg:py-14">
        <nav class="mb-8 flex flex-wrap items-center gap-1.5 text-sm text-[var(--color-stone-400)]" aria-label="Breadcrumb">
          <a href="/" class="hover:text-[var(--color-forest-700)] transition-colors">Home</a>
          <span>/</span>
          <a href="/reviews/" class="hover:text-[var(--color-forest-700)] transition-colors">Reviews</a>
          <span>/</span>
          <span class="text-[var(--color-stone-700)] font-medium">{review.drinkName}</span>
        </nav>

        <div class="grid gap-9 lg:grid-cols-[1.05fr_0.95fr] lg:items-center">
          <div class="space-y-5">
            <div class="flex flex-wrap items-center gap-2">
              {review.brand && (
                <span class="text-xs font-bold tracking-[0.16em] uppercase text-[var(--color-forest-700)]">{review.brand}</span>
              )}
              <span class="text-xs text-[var(--color-stone-400)]">{purchaseDate}</span>
            </div>
            <h1 class="text-3xl lg:text-5xl font-display font-bold leading-tight text-[var(--color-stone-900)]">
              {title}
            </h1>
            <p class="text-lg leading-relaxed text-[var(--color-stone-600)]">
              {articleParagraphs[0]}
            </p>
            <p class="text-sm text-[var(--color-stone-500)]">{byline}</p>
          </div>

          <div class="overflow-hidden rounded-lg border border-[var(--color-stone-200)] bg-white">
            {heroPhoto ? (
              <img
                src={heroPhoto.url}
                alt={`${title} cup photo`}
                class="aspect-[4/3] w-full object-cover"
                fetchpriority="high"
                decoding="async"
                width={heroPhoto.width ?? 1000}
                height={heroPhoto.height ?? 750}
              />
            ) : (
              <div class="aspect-[4/3] w-full flex items-center justify-center bg-[var(--color-cream-100)]">
                <span class="text-xs font-semibold tracking-[0.2em] uppercase text-[var(--color-stone-400)]">Review</span>
              </div>
            )}
          </div>
        </div>
      </div>
    </section>

    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12 lg:py-16">
      <div class="grid gap-10 lg:grid-cols-[minmax(0,1fr)_20rem]">
        <div class="blog-prose max-w-none">
          {bodyParagraphs.map(paragraph => (
            <p class="whitespace-pre-line">{paragraph}</p>
          ))}

          <h2>Photos from the visit</h2>
          <p>
            These are the photos submitted with the review: the cup, the shop and the receipt.
          </p>

          <div class="grid gap-4 sm:grid-cols-3">
            {review.photos.map(photo => (
              <figure class="m-0">
                <img
                  src={photo.url}
                  alt={`${title} ${photo.label.toLowerCase()} photo`}
                  class="aspect-square w-full object-cover rounded-lg"
                  loading="lazy"
                  decoding="async"
                  width={photo.width ?? 600}
                  height={photo.height ?? 600}
                />
                <figcaption>{photo.label} photo</figcaption>
              </figure>
            ))}
          </div>
        </div>

        <aside class="space-y-5">
          <div class="rounded-lg border border-[var(--color-stone-200)] bg-white p-5 sticky top-24">
            <h2 class="text-base font-display font-semibold text-[var(--color-stone-900)] mb-4">Review Details</h2>
            <dl class="space-y-3">
              {quickFacts.map(item => (
                <div class="border-b border-[var(--color-stone-200)] pb-3 last:border-b-0 last:pb-0">
                  <dt class="text-xs font-semibold uppercase tracking-[0.14em] text-[var(--color-stone-400)]">{item.label}</dt>
                  <dd class="mt-1 text-sm font-medium text-[var(--color-stone-800)]">{item.value}</dd>
                </div>
              ))}
            </dl>
            {entityLinks.length > 0 && (
              <div class="mt-5 pt-5 border-t border-[var(--color-stone-200)] space-y-3">
                <h3 class="text-xs font-semibold uppercase tracking-[0.14em] text-[var(--color-stone-400)]">Related pages</h3>
                <div class="flex flex-col gap-2">
                  {entityLinks.map(link => (
                    <a href={link.href} class="text-sm font-semibold text-[var(--color-forest-700)] hover:text-[var(--color-forest-800)] transition-colors">
                      {link.label}
                    </a>
                  ))}
                </div>
              </div>
            )}
          </div>
        </aside>
      </div>
    </div>
  </article>
</Layout>
