---
import Layout from '../components/Layout.astro';
import SearchBox from '../components/SearchBox.astro';
import ListingCard from '../components/ListingCard.astro';
import BrandCard from '../components/BrandCard.astro';
import TownCard from '../components/TownCard.astro';
import CategoryCard from '../components/CategoryCard.astro';
import { getBrands, getOutlets, getCategories, getTowns } from '../lib/airtable';
import { getTownsFromOutlets } from '../lib/towns';

const [brands, outlets, categories, allTowns] = await Promise.all([
  getBrands(),
  getOutlets(),
  getCategories(),
  getTowns(),
]);
const towns = getTownsFromOutlets(outlets, allTowns);

const featuredBrands   = brands.filter(b => b.featured).slice(0, 5);
const featuredOutlets  = outlets.filter(o => o.featured).slice(0, 6);
const featuredTowns    = towns.slice(0, 8);
const featuredCategories = categories.slice(0, 4);

// Outlet count per brand
const brandOutletCount = (brandSlug: string) =>
  outlets.filter(o => o.brandSlug === brandSlug).length;

// Outlet count per town
const townOutletCount = (townSlug: string) =>
  outlets.filter(o => o.townSlug === townSlug).length;

// Outlet count per category
const categoryOutletCount = (catSlug: string) =>
  outlets.filter(o => o.drinkCategorySlugs?.includes(catSlug)).length;

const totalOutlets = outlets.length;
const totalBrands  = brands.length;
const totalTowns   = towns.length;
---

<Layout
  title="BBTea - Singapore Bubble Tea Directory"
  description="Discover the best bubble tea shops across Singapore. Browse by town, brand, or drink type and find your perfect boba."
>

  <!-- ═══════════════════════════════════
       HERO
  ════════════════════════════════════ -->
  <section class="relative bg-white border-b border-[var(--color-stone-200)]" aria-label="Hero">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 lg:py-28">
      <div class="grid lg:grid-cols-[1.1fr_0.9fr] gap-12 lg:gap-20 items-center">
        <div class="space-y-8">
          <p class="text-xs font-semibold tracking-[0.2em] uppercase text-[var(--color-forest-700)]">
            Singapore Bubble Tea Directory
          </p>

          <div class="space-y-5">
            <h1 class="text-4xl sm:text-5xl lg:text-6xl xl:text-7xl font-display font-semibold text-[var(--color-stone-900)] leading-[0.98] text-balance">
              Find bubble tea shops across Singapore.
            </h1>
            <p class="text-base lg:text-lg text-[var(--color-stone-600)] max-w-2xl leading-relaxed">
              A clean guide to {totalOutlets} outlets, {totalBrands} brands, and {totalTowns} neighbourhoods.
              Search by shop, town, brand, MRT, or drink type.
            </p>
          </div>

          <div class="max-w-2xl">
            <SearchBox large placeholder="Search shops, towns, brands, MRT..." id="hero-search" />
          </div>

          <div class="flex flex-wrap items-center gap-2">
            {['Brown Sugar', 'Orchard', 'Halal-Friendly', 'Jurong East', 'Tiger Sugar'].map(tag => (
              <a
                href={`/search?q=${encodeURIComponent(tag)}`}
                class="text-xs px-3 py-2 rounded-md bg-white text-[var(--color-stone-700)] hover:text-[var(--color-stone-900)] border border-[var(--color-stone-200)] hover:border-[var(--color-stone-900)] transition-colors"
              >
                {tag}
              </a>
            ))}
          </div>
        </div>

        <div class="border border-[var(--color-stone-200)] rounded-lg p-6 lg:p-8 bg-white">
          <dl class="grid grid-cols-1 divide-y divide-[var(--color-stone-200)]">
            {[
              { value: totalOutlets, label: 'Outlets Listed' },
              { value: totalBrands,  label: 'Brands' },
              { value: totalTowns,   label: 'Neighbourhoods' },
            ].map(stat => (
              <div class="flex items-baseline justify-between gap-6 py-6 first:pt-0 last:pb-0">
                <dt class="text-sm text-[var(--color-stone-500)]">{stat.label}</dt>
                <dd class="text-4xl font-display font-semibold text-[var(--color-stone-900)]">{stat.value}+</dd>
              </div>
            ))}
          </dl>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════
       FEATURED SHOPS
  ════════════════════════════════════ -->
  <section class="py-20 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto">
    <header class="mb-10 flex items-end justify-between gap-4">
      <div class="space-y-2">
        <p class="text-xs font-semibold tracking-[0.2em] uppercase text-[var(--color-forest-700)]">Curated Selection</p>
        <h2 class="text-3xl lg:text-4xl font-display font-bold text-[var(--color-stone-900)]">
          Featured Shops
        </h2>
        <p class="text-[var(--color-stone-600)] text-base max-w-lg">
          Hand-picked bubble tea destinations worth a detour, wherever you are on the island.
        </p>
      </div>
      <a
        href="/directory"
        class="hidden sm:inline-flex shrink-0 items-center gap-1.5 text-sm font-semibold text-[var(--color-forest-700)] hover:text-[var(--color-forest-800)] transition-colors link-underline"
      >
        View all {totalOutlets} shops
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
        </svg>
      </a>
    </header>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {featuredOutlets.map((outlet, i) => (
        <ListingCard outlet={outlet} featured={i === 0} />
      ))}
    </div>

    <div class="mt-10 text-center">
      <a
        href="/directory"
        class="inline-flex items-center gap-2 px-8 py-3.5 rounded-lg bg-[var(--color-stone-900)] text-white text-sm font-semibold hover:bg-white hover:text-[var(--color-stone-900)] border border-[var(--color-stone-900)] transition-colors shadow-none"
      >
        Explore the Full Directory
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
        </svg>
      </a>
    </div>
  </section>

  <!-- ═══════════════════════════════════
       TOWNS
  ════════════════════════════════════ -->
  <section class="py-20 bg-[var(--color-cream-100)]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <header class="mb-10 flex items-end justify-between gap-4">
        <div class="space-y-2">
          <p class="text-xs font-semibold tracking-[0.2em] uppercase text-[var(--color-forest-700)]">Browse by Location</p>
          <h2 class="text-3xl lg:text-4xl font-display font-bold text-[var(--color-stone-900)]">
            Explore by Town
          </h2>
          <p class="text-[var(--color-stone-600)] text-base max-w-lg">
            Find boba near you — from heartland favourites to Orchard corridor flagship stores.
          </p>
        </div>
      </header>

      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4">
        {featuredTowns.map(town => (
          <TownCard town={town} outletCount={townOutletCount(town.slug)} />
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════
       DRINK CATEGORIES
  ════════════════════════════════════ -->
  <section class="py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <header class="mb-10 space-y-2">
        <p class="text-xs font-semibold tracking-[0.2em] uppercase text-[var(--color-forest-700)]">What Are You Craving?</p>
        <h2 class="text-3xl lg:text-4xl font-display font-bold text-[var(--color-stone-900)]">
          Browse by Drink Type
        </h2>
        <p class="text-[var(--color-stone-600)] text-base max-w-lg">
          From classic milk teas to indulgent brown sugar creations — find your signature order.
        </p>
      </header>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
        {featuredCategories.map(cat => (
          <CategoryCard category={cat} outletCount={categoryOutletCount(cat.slug)} />
        ))}
      </div>

      <div class="mt-8 text-center">
        <a
          href="/drinks"
          class="text-sm font-semibold text-[var(--color-forest-700)] hover:text-[var(--color-forest-800)] link-underline transition-colors"
        >
          Browse all drink types →
        </a>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════
       BRANDS
  ════════════════════════════════════ -->
  <section class="py-20 bg-[var(--color-cream-100)]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <header class="mb-10 flex items-end justify-between gap-4">
        <div class="space-y-2">
          <p class="text-xs font-semibold tracking-[0.2em] uppercase text-[var(--color-forest-700)]">The Names You Know</p>
          <h2 class="text-3xl lg:text-4xl font-display font-bold text-[var(--color-stone-900)]">
            Featured Brands
          </h2>
          <p class="text-[var(--color-stone-600)] text-base max-w-lg">
            From Taiwan-born icons to Singapore originals — meet the brands shaping the boba scene here.
          </p>
        </div>
      </header>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-5">
        {featuredBrands.map(brand => (
          <BrandCard brand={brand} outletCount={brandOutletCount(brand.slug)} />
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════
       EDITORIAL STRIP
  ════════════════════════════════════ -->
  <section class="py-24 bg-white border-t border-[var(--color-stone-200)]">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 text-center space-y-6">
      <h2 class="text-3xl lg:text-5xl font-display font-semibold leading-tight text-[var(--color-stone-900)]">
        Find your next cup without the clutter.
      </h2>
      <p class="text-[var(--color-stone-600)] text-base leading-relaxed max-w-xl mx-auto">
        Browse the directory by location, brand, station, or drink type, then go straight to the details that matter.
      </p>
      <a
        href="/directory"
        class="inline-flex items-center gap-2 px-8 py-3.5 rounded-lg bg-[var(--color-stone-900)] text-white text-sm font-semibold hover:bg-white hover:text-[var(--color-stone-900)] border border-[var(--color-stone-900)] transition-colors"
      >
        Find Your Next Cup
      </a>
    </div>
  </section>

</Layout>
