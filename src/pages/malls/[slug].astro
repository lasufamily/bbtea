---
import Layout from '../../components/Layout.astro';
import ListingCard from '../../components/ListingCard.astro';
import { getCoffeeOutlets, getMalls, getOutlets } from '../../lib/airtable';
import type { Mall } from '../../lib/types';

export async function getStaticPaths() {
  const [allOutlets, coffeeOutlets, malls] = await Promise.all([getOutlets(), getCoffeeOutlets(), getMalls()]);

  return malls.map(mall => {
    const outlets = allOutlets.filter(o => o.mallSlug === mall.slug);
    const coffee = coffeeOutlets.filter(o => o.mallSlug === mall.slug);
    return {
      params: { slug: mall.slug },
      props:  { mall, outlets, coffeeOutlets: coffee, allMalls: malls },
    };
  });
}

interface Props {
  mall: Mall;
  outlets: Awaited<ReturnType<typeof getOutlets>>;
  coffeeOutlets: Awaited<ReturnType<typeof getCoffeeOutlets>>;
  allMalls: Mall[];
}
const { mall, outlets, coffeeOutlets, allMalls } = Astro.props;

const brandSet = [...new Set([...outlets, ...coffeeOutlets].map(o => o.brandName).filter(Boolean))];
const townSet = [...new Set([...outlets, ...coffeeOutlets].map(o => o.town).filter(Boolean))];
const venueCount = outlets.length + coffeeOutlets.length;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: `Bubble Tea and Coffee Shops at ${mall.name}, Singapore`,
  description: mall.description ?? `Discover bubble tea and coffee shops at ${mall.name}, Singapore.`,
  url: `https://bbtea.sg/malls/${mall.slug}/`,
};
---

<Layout
  title={`Bubble Tea and Coffee Shops at ${mall.name} | BBTea.sg`}
  description={`Discover ${outlets.length} bubble tea shops and ${coffeeOutlets.length} coffee shops at ${mall.name}, Singapore. ${mall.description ?? ''}`}
  image={mall.image}
  canonical={`https://bbtea.sg/malls/${mall.slug}/`}
  jsonLd={jsonLd}
>

  <!-- Page hero -->
  <section class="bg-white border-b border-[var(--color-stone-200)] py-16">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 space-y-4" data-pagefind-body>
      <nav class="text-sm text-[var(--color-stone-400)] flex items-center gap-1.5" aria-label="Breadcrumb">
        <a href="/" class="hover:text-[var(--color-forest-700)] transition-colors">Home</a>
        <span>/</span>
        <a href="/directory/" class="hover:text-[var(--color-forest-700)] transition-colors">Directory</a>
        <span>/</span>
        <a href="/malls/" class="hover:text-[var(--color-forest-700)] transition-colors text-[var(--color-stone-700)]">Malls</a>
        <span>/</span>
        <span class="text-[var(--color-stone-700)] font-medium">{mall.name}</span>
      </nav>
      <p class="text-xs font-semibold tracking-[0.2em] uppercase text-[var(--color-forest-700)]">
        {mall.name} · Singapore
      </p>
      <h1 class="text-3xl lg:text-5xl font-display font-bold leading-tight">
        Bubble Tea and Coffee<br />
        at {mall.name}
      </h1>
      {mall.description && (
        <p class="text-[var(--color-stone-600)] text-base max-w-2xl leading-relaxed">
          {mall.description}
        </p>
      )}
      <div class="flex flex-wrap items-center gap-6 pt-2">
        <div class="text-sm">
          <span class="font-bold text-xl">{venueCount}</span>
          <span class="text-[var(--color-stone-400)] ml-1">{venueCount === 1 ? 'venue' : 'venues'}</span>
        </div>
        {brandSet.length > 0 && (
          <div class="text-sm">
            <span class="font-bold text-xl">{brandSet.length}</span>
            <span class="text-[var(--color-stone-400)] ml-1">{brandSet.length === 1 ? 'brand' : 'brands'}</span>
          </div>
        )}
      </div>
    </div>
  </section>

  {(brandSet.length > 0 || townSet.length > 0) && (
    <section class="bg-[var(--color-cream-100)] border-b border-[var(--color-stone-200)] py-4">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-wrap gap-2">
        {townSet.map(town => (
          <span class="text-xs px-3 py-1.5 rounded-lg bg-white border border-[var(--color-stone-200)] text-[var(--color-stone-600)] font-medium">
            {town}
          </span>
        ))}
        {brandSet.map(brand => (
          <span class="text-xs px-3 py-1.5 rounded-lg bg-white border border-[var(--color-stone-200)] text-[var(--color-stone-600)] font-medium">
            {brand}
          </span>
        ))}
      </div>
    </section>
  )}

  <!-- Outlets -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    {venueCount > 0 ? (
      <div class="space-y-12">
        {outlets.length > 0 && (
          <section class="space-y-5">
            <h2 class="text-xl font-display font-semibold text-[var(--color-stone-900)]">Bubble Tea Shops</h2>
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-5">
              {outlets.map(outlet => <ListingCard outlet={outlet} />)}
            </div>
          </section>
        )}
        {coffeeOutlets.length > 0 && (
          <section class="space-y-5">
            <h2 class="text-xl font-display font-semibold text-[var(--color-stone-900)]">Coffee Shops</h2>
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-5">
              {coffeeOutlets.map(outlet => <ListingCard outlet={outlet} />)}
            </div>
          </section>
        )}
      </div>
    ) : (
      <div class="text-center py-20 space-y-4">
        <p class="text-sm font-semibold tracking-[0.2em] uppercase text-[var(--color-stone-400)]">No Results</p>
        <h2 class="text-xl font-display font-semibold text-[var(--color-stone-800)]">
          No shops listed at {mall.name} yet
        </h2>
        <p class="text-[var(--color-stone-500)] max-w-sm mx-auto">
          We're growing our directory. Check back soon or browse all available shops.
        </p>
        <a href="/directory/" class="inline-flex items-center gap-2 mt-2 px-6 py-3 rounded-lg bg-[var(--color-forest-700)] text-white text-sm font-semibold hover:bg-white hover:text-[var(--color-forest-700)] border border-[var(--color-forest-700)] transition-colors">
          Browse All Shops
        </a>
      </div>
    )}
  </div>

  <!-- Other malls -->
  <section class="bg-[var(--color-cream-100)] border-t border-[var(--color-stone-200)] py-12">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-6">
      <h2 class="text-xl font-display font-semibold text-[var(--color-stone-900)]">
        Explore Other Malls
      </h2>
      <div class="flex flex-wrap gap-2">
        {allMalls.filter(m => m.slug !== mall.slug).map(m => (
          <a
            href={`/malls/${m.slug}/`}
            class="text-sm px-4 py-2 rounded-lg bg-white border border-[var(--color-stone-200)] text-[var(--color-stone-600)] hover:border-[var(--color-forest-700)] hover:text-[var(--color-forest-700)] transition-colors font-medium"
          >
            {m.name}
          </a>
        ))}
      </div>
    </div>
  </section>

</Layout>
