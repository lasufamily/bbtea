---
import Layout from '../../components/Layout.astro';
import MallCard from '../../components/MallCard.astro';
import { getCoffeeOutlets, getMalls, getOutlets } from '../../lib/airtable';

const [malls, outlets, coffeeOutlets] = await Promise.all([getMalls(), getOutlets(), getCoffeeOutlets()]);

const mallOutletCount = (mallSlug: string) =>
  outlets.filter(o => o.mallSlug === mallSlug).length + coffeeOutlets.filter(o => o.mallSlug === mallSlug).length;

const totalOutlets = outlets.filter(o => o.mallSlug).length + coffeeOutlets.filter(o => o.mallSlug).length;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Bubble Tea and Coffee by Mall in Singapore',
  description: 'Browse bubble tea and coffee shops by shopping mall and food centre across Singapore.',
  url: 'https://bbtea.sg/malls/',
};
---

<Layout
  title="Bubble Tea and Coffee by Mall in Singapore | BBTea.sg"
  description={`Browse bubble tea and coffee shops across ${malls.length} malls, food centres, and shopping destinations in Singapore.`}
  canonical="https://bbtea.sg/malls/"
  jsonLd={jsonLd}
>

  <!-- Hero -->
  <section class="bg-white border-b border-[var(--color-stone-200)] py-16">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 space-y-4" data-pagefind-body>
      <nav class="text-sm text-[var(--color-stone-400)] flex items-center gap-1.5" aria-label="Breadcrumb">
        <a href="/" class="hover:text-[var(--color-forest-700)] transition-colors">Home</a>
        <span>/</span>
        <span class="text-[var(--color-stone-700)] font-medium">Malls</span>
      </nav>
      <p class="text-xs font-semibold tracking-[0.2em] uppercase text-[var(--color-forest-700)]">
        Browse by Mall
      </p>
      <h1 class="text-3xl lg:text-5xl font-display font-bold leading-tight">
        Bubble Tea and Coffee by Mall
      </h1>
      <p class="text-[var(--color-stone-600)] text-base max-w-2xl leading-relaxed">
        Find boba and coffee at Singapore's malls, markets, food centres, and shopping destinations.
      </p>
      <div class="flex flex-wrap items-center gap-6 pt-2">
        <div class="text-sm">
          <span class="font-bold text-xl">{malls.length}</span>
          <span class="text-[var(--color-stone-400)] ml-1">locations</span>
        </div>
        <div class="text-sm">
          <span class="font-bold text-xl">{totalOutlets}</span>
          <span class="text-[var(--color-stone-400)] ml-1">shops in malls</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Mall grid -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14">
    <h2 class="sr-only">All Bubble Tea Mall Locations</h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-5">
      {malls.map(mall => (
        <MallCard mall={mall} outletCount={mallOutletCount(mall.slug)} />
      ))}
    </div>
  </section>

</Layout>
