---
import Layout from '../components/Layout.astro';
import SearchBox from '../components/SearchBox.astro';

const query = Astro.url.searchParams.get('q') ?? '';
---

<Layout
  title={query ? `Search results for "${query}" | BBTea.sg` : 'Search | BBTea.sg'}
  description="Search for bubble tea shops, brands, towns, MRT stations and drink types across Singapore."
>

  <!-- Header -->
  <section class="bg-[var(--color-cream-100)] border-b border-[var(--color-stone-200)] py-12">
    <div class="max-w-2xl mx-auto px-4 sm:px-6 space-y-4">
      <p class="text-xs font-semibold tracking-[0.2em] uppercase text-[var(--color-forest-700)]">
        Search
      </p>
      <h1 id="search-heading" class="text-3xl font-display font-bold text-[var(--color-stone-900)]">
        {query ? <>Results for <em class="not-italic text-[var(--color-forest-700)]">"{query}"</em></> : 'Find Your Perfect Boba'}
      </h1>
      <SearchBox large placeholder="Search shops, brands, towns, drinks…" id="main-search" value={query} />
    </div>
  </section>

  <!-- Pagefind results -->
  <section class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <h2 id="search-results-heading" class="sr-only">{query ? 'Search Results' : 'Search Suggestions'}</h2>

    <!-- Search results are injected here after build -->
    <div id="pagefind-search" class="space-y-6" aria-live="polite">
      {!query && (
        <div class="text-center py-16 space-y-4">
          <p class="text-sm font-semibold tracking-[0.2em] uppercase text-[var(--color-stone-400)]">Search</p>
          <p class="text-[var(--color-stone-500)] text-base">
            Type something above to search across all shops, brands, and towns.
          </p>
          <div class="flex flex-wrap gap-2 justify-center pt-2">
            {['Tiger Sugar', 'Brown Sugar', 'Orchard', 'Halal', 'Matcha', 'Taro'].map(s => (
              <a
                href={`/search?q=${encodeURIComponent(s)}`}
                class="text-sm px-4 py-2 rounded-lg bg-[var(--color-cream-100)] text-[var(--color-stone-600)] border border-[var(--color-stone-200)] hover:border-[var(--color-forest-700)] hover:text-[var(--color-forest-700)] transition-colors"
              >
                {s}
              </a>
            ))}
          </div>
        </div>
      )}
    </div>

  </section>

</Layout>

<script is:inline>
  async function initPagefind() {
    const el = document.getElementById('pagefind-search');
    if (!el) return;
    const searchTerm = new URLSearchParams(window.location.search).get('q')?.trim() ?? '';
    const heading = document.getElementById('search-heading');
    const resultsHeading = document.getElementById('search-results-heading');
    const mainSearch = document.getElementById('main-search');

    if (!searchTerm) return;

    if (heading) {
      heading.innerHTML = `Results for <em class="not-italic text-[var(--color-forest-700)]"></em>`;
      const term = heading.querySelector('em');
      if (term) term.textContent = `"${searchTerm}"`;
    }
    if (mainSearch instanceof HTMLInputElement) {
      mainSearch.value = searchTerm;
    }
    if (resultsHeading) {
      resultsHeading.textContent = 'Search Results';
    }

    el.innerHTML = '<p class="text-[var(--color-stone-500)]">Searching...</p>';

    try {
      const pagefind = await import('/pagefind/pagefind.js');
      const search = await pagefind.search(searchTerm);
      const results = await Promise.all(
        search.results.slice(0, 10).map((result) => result.data())
      );

      if (!results.length) {
        el.innerHTML = `<p class="text-[var(--color-stone-600)]">No results found for ${escapeHtml(searchTerm)}.</p>`;
        return;
      }

      const resultLabel = `${search.results.length} ${search.results.length === 1 ? 'result' : 'results'} for ${escapeHtml(searchTerm)}`;
      el.innerHTML = `
        <p class="text-sm font-semibold text-[var(--color-stone-700)]">${resultLabel}</p>
        <ol class="divide-y divide-[var(--color-stone-200)]">
          ${results.map(renderResult).join('')}
        </ol>
      `;
    } catch (error) {
      console.error(error);
      el.innerHTML = '<p class="text-[var(--color-stone-600)]">Search results could not be loaded. Please try again.</p>';
    }
  }

  function renderResult(result) {
    const title = escapeHtml(result.meta?.title || 'Untitled');
    const url = escapeHtml(result.meta?.url || result.url || '#');
    const excerpt = result.excerpt || '';
    const image = result.meta?.image
      ? `<img src="${escapeHtml(result.meta.image)}" alt="" class="w-16 h-16 rounded-md object-cover bg-[var(--color-cream-100)] flex-none" loading="lazy" />`
      : '';

    return `
      <li class="py-6">
        <a href="${url}" class="group flex gap-5">
          ${image}
          <span class="space-y-2 min-w-0">
            <span class="block font-display text-lg font-semibold text-[var(--color-stone-900)] group-hover:text-[var(--color-forest-700)] transition-colors">${title}</span>
            <span class="block text-sm sm:text-base text-[var(--color-stone-600)] leading-relaxed">${excerpt}</span>
          </span>
        </a>
      </li>
    `;
  }

  function escapeHtml(value) {
    return String(value)
      .replaceAll('&', '&amp;')
      .replaceAll('<', '&lt;')
      .replaceAll('>', '&gt;')
      .replaceAll('"', '&quot;')
      .replaceAll("'", '&#039;');
  }

  if (document.readyState === 'complete') {
    initPagefind();
  } else {
    window.addEventListener('load', initPagefind);
  }
</script>

<style is:global>
  mark {
    background: #fff35a;
    color: inherit;
    padding: 0 0.1em;
  }
</style>
