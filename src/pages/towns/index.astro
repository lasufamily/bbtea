---
import Layout from '../../components/Layout.astro';
import TownCard from '../../components/TownCard.astro';
import { getOutlets, getTowns } from '../../lib/airtable';
import { getTownsFromOutlets } from '../../lib/towns';

const [outlets, allTowns] = await Promise.all([getOutlets(), getTowns()]);
const towns = getTownsFromOutlets(outlets, allTowns);

const townOutletCount = (townSlug: string) =>
  outlets.filter(o => o.townSlug === townSlug).length;

const totalOutlets = outlets.length;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Bubble Tea by Town — Singapore',
  description: 'Browse bubble tea shops by neighbourhood across Singapore.',
  url: 'https://bbtea.sg/towns',
};
---

<Layout
  title="Bubble Tea by Town in Singapore | Bubble Tea SG"
  description={`Browse bubble tea shops across ${towns.length} neighbourhoods in Singapore.`}
  canonical="https://bbtea.sg/towns"
  jsonLd={jsonLd}
>

  <!-- Hero -->
  <section class="bg-white border-b border-[var(--color-stone-200)] py-16">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 space-y-4" data-pagefind-body>
      <nav class="text-sm text-[var(--color-stone-400)] flex items-center gap-1.5" aria-label="Breadcrumb">
        <a href="/" class="hover:text-[var(--color-stone-900)] transition-colors">Home</a>
        <span>/</span>
        <span class="text-[var(--color-stone-700)] font-medium">Towns</span>
      </nav>
      <p class="text-xs font-semibold tracking-[0.2em] uppercase text-[var(--color-forest-700)]">
        Browse by Location
      </p>
      <h1 class="text-3xl lg:text-5xl font-display font-bold leading-tight">
        Bubble Tea by Town
      </h1>
      <p class="text-[var(--color-stone-600)] text-base max-w-2xl leading-relaxed">
        Find the best boba shops in your neighbourhood — from heartland favourites to Orchard corridor flagships.
      </p>
      <div class="flex flex-wrap items-center gap-6 pt-2">
        <div class="text-sm">
          <span class="font-bold text-xl">{towns.length}</span>
          <span class="text-[var(--color-stone-400)] ml-1">neighbourhoods</span>
        </div>
        <div class="text-sm">
          <span class="font-bold text-xl">{totalOutlets}</span>
          <span class="text-[var(--color-stone-400)] ml-1">shops listed</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Town grid -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14">
    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4">
      {towns.map(town => (
        <TownCard town={town} outletCount={townOutletCount(town.slug)} />
      ))}
    </div>
  </section>

</Layout>
