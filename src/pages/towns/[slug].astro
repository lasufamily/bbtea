---
import Layout from '../../components/Layout.astro';
import ListingCard from '../../components/ListingCard.astro';
import { getOutlets, getTowns } from '../../lib/airtable';
import type { Town } from '../../lib/types';

export async function getStaticPaths() {
  const [allOutlets, towns] = await Promise.all([getOutlets(), getTowns()]);
  return towns.map(town => {
    const outlets = allOutlets.filter(o => o.townSlug === town.slug);
    return {
      params: { slug: town.slug },
      props:  { town, outlets, allTowns: towns },
    };
  });
}

interface Props {
  town: Town;
  outlets: Awaited<ReturnType<typeof getOutlets>>;
  allTowns: Town[];
}
const { town, outlets, allTowns } = Astro.props;

// Unique brands in this town
const brandSet = [...new Set(outlets.map(o => o.brandName))];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: `Best Bubble Tea Shops in ${town.name}, Singapore`,
  description: town.description ?? `Discover the best bubble tea shops in ${town.name}, Singapore.`,
  url: `https://bubbleteasg.com/towns/${town.slug}`,
};
---

<Layout
  title={`Best Bubble Tea Shops in ${town.name} | Bubble Tea SG`}
  description={`Discover ${outlets.length} bubble tea shops in ${town.name}, Singapore. ${town.description ?? ''}`}
  canonical={`https://bubbleteasg.com/towns/${town.slug}`}
  jsonLd={jsonLd}
>

  <!-- Page hero -->
  <section class="bg-white border-b border-[var(--color-stone-200)] py-16">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 space-y-4" data-pagefind-body>
      <nav class="text-sm text-[var(--color-stone-400)] flex items-center gap-1.5" aria-label="Breadcrumb">
        <a href="/" class="hover:text-[var(--color-stone-900)] transition-colors">Home</a>
        <span>/</span>
        <a href="/directory" class="hover:text-[var(--color-stone-900)] transition-colors">Directory</a>
        <span>/</span>
        <a href="/towns" class="hover:text-[var(--color-stone-900)] transition-colors text-[var(--color-stone-700)]">Towns</a>
        <span>/</span>
        <span class="text-[var(--color-stone-700)] font-medium">{town.name}</span>
      </nav>
      <p class="text-xs font-semibold tracking-[0.2em] uppercase text-[var(--color-forest-700)]">
        {town.name} · Singapore
      </p>
      <h1 class="text-3xl lg:text-5xl font-display font-bold leading-tight">
        Best Bubble Tea Shops<br />
        in {town.name}
      </h1>
      {town.description && (
        <p class="text-[var(--color-stone-600)] text-base max-w-2xl leading-relaxed">
          {town.description}
        </p>
      )}
      <!-- Quick stats -->
      <div class="flex flex-wrap items-center gap-6 pt-2">
        <div class="text-sm">
          <span class="font-bold text-xl">{outlets.length}</span>
          <span class="text-[var(--color-stone-400)] ml-1">{outlets.length === 1 ? 'shop' : 'shops'}</span>
        </div>
        {brandSet.length > 0 && (
          <div class="text-sm">
            <span class="font-bold text-xl">{brandSet.length}</span>
            <span class="text-[var(--color-stone-400)] ml-1">{brandSet.length === 1 ? 'brand' : 'brands'}</span>
          </div>
        )}
      </div>
    </div>
  </section>

  <!-- Brand pills -->
  {brandSet.length > 0 && (
    <section class="bg-[var(--color-cream-100)] border-b border-[var(--color-stone-200)] py-4">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-wrap gap-2">
        <span class="text-xs font-semibold text-[var(--color-stone-400)] self-center mr-1">Brands:</span>
        {brandSet.map(b => (
          <span class="text-xs px-3 py-1.5 rounded-lg bg-white border border-[var(--color-stone-200)] text-[var(--color-stone-600)] font-medium">
            {b}
          </span>
        ))}
      </div>
    </section>
  )}

  <!-- Outlets -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    {outlets.length > 0 ? (
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-5">
        {outlets.map(outlet => <ListingCard outlet={outlet} />)}
      </div>
    ) : (
      <div class="text-center py-20 space-y-4">
        <p class="text-sm font-semibold tracking-[0.2em] uppercase text-[var(--color-stone-400)]">No Results</p>
        <h2 class="text-xl font-display font-semibold text-[var(--color-stone-800)]">
          No shops listed in {town.name} yet
        </h2>
        <p class="text-[var(--color-stone-500)] max-w-sm mx-auto">
          We're growing our directory. Check back soon or browse all available shops.
        </p>
        <a href="/directory" class="inline-flex items-center gap-2 mt-2 px-6 py-3 rounded-lg bg-[var(--color-stone-900)] text-white text-sm font-semibold hover:bg-white hover:text-[var(--color-stone-900)] border border-[var(--color-stone-900)] transition-colors">
          Browse All Shops
        </a>
      </div>
    )}
  </div>

  <!-- Neighbouring towns -->
  <section class="bg-[var(--color-cream-100)] border-t border-[var(--color-stone-200)] py-12">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-6">
      <h2 class="text-xl font-display font-semibold text-[var(--color-stone-900)]">
        Explore Other Towns
      </h2>
      <div class="flex flex-wrap gap-2">
        {allTowns.filter(t => t.slug !== town.slug).map(t => (
          <a
            href={`/towns/${t.slug}`}
            class="text-sm px-4 py-2 rounded-lg bg-white border border-[var(--color-stone-200)] text-[var(--color-stone-600)] hover:border-[var(--color-forest-700)] hover:text-[var(--color-forest-700)] transition-colors font-medium"
          >
            {t.name}
          </a>
        ))}
      </div>
    </div>
  </section>

</Layout>
