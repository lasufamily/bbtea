---
import Layout from '../../components/Layout.astro';
import ListingCard from '../../components/ListingCard.astro';
import { getCoffeeOutlets, getJuiceOutlets, getOutlets, getTowns, getAllVenueTowns } from '../../lib/airtable';
import { topBrandLinks, topMallLinks, topStationLinks } from '../../lib/internalLinks';
import type { Town } from '../../lib/types';

export async function getStaticPaths() {
  const [allOutlets, coffeeOutlets, juiceOutlets, towns] = await Promise.all([getOutlets(), getCoffeeOutlets(), getJuiceOutlets(), getTowns()]);
  const activeTowns = getAllVenueTowns([...allOutlets, ...coffeeOutlets, ...juiceOutlets], [], towns);

  return activeTowns.map(town => {
    const outlets = allOutlets.filter(o => o.townSlug === town.slug);
    const coffee = coffeeOutlets.filter(o => o.townSlug === town.slug);
    const juice = juiceOutlets.filter(o => o.townSlug === town.slug);
    return {
      params: { slug: town.slug },
      props:  { town, outlets, coffeeOutlets: coffee, juiceOutlets: juice, allTowns: activeTowns },
    };
  });
}

interface Props {
  town: Town;
  outlets: Awaited<ReturnType<typeof getOutlets>>;
  coffeeOutlets: Awaited<ReturnType<typeof getCoffeeOutlets>>;
  juiceOutlets: Awaited<ReturnType<typeof getJuiceOutlets>>;
  allTowns: Town[];
}
const { town, outlets, coffeeOutlets, juiceOutlets, allTowns } = Astro.props;
const venueCount = outlets.length + coffeeOutlets.length + juiceOutlets.length;
const townVenues = [...outlets, ...coffeeOutlets, ...juiceOutlets];

const brandLinks = topBrandLinks(townVenues, 10);
const mallLinks = topMallLinks(townVenues, 8);
const stationLinks = topStationLinks(townVenues, 8);
const sections = [
  { id: 'bubble-tea', title: 'Bubble tea', venues: outlets },
  { id: 'coffee', title: 'Coffee', venues: coffeeOutlets },
  { id: 'juice', title: 'Juice', venues: juiceOutlets },
];
const description = `Find bubble tea, coffee and juice shops in ${town.name}. Browse outlet addresses, opening hours, malls and nearby MRT stations.`;
const jsonLd = {
  '@context': 'https://schema.org', '@type': 'CollectionPage',
  name: `Drink shops in ${town.name}`, description,
  url: `https://bbtea.sg/towns/${town.slug}/`,
  mainEntity: { '@type': 'ItemList', itemListElement: townVenues.map((venue, index) => ({
    '@type': 'ListItem', position: index + 1, name: venue.name,
    url: `https://bbtea.sg${'path' in venue ? venue.path : `/bubble-tea-shops/${venue.slug}/`}`,
  })) },
};
---
<Layout title={`Bubble Tea, Coffee & Juice in ${town.name} | BBTea.sg`} description={description} canonical={`https://bbtea.sg/towns/${town.slug}/`} jsonLd={jsonLd}>
  <section class="max-w-7xl mx-auto px-4 sm:px-6 py-14 space-y-8" data-pagefind-body>
    <nav class="text-sm flex gap-2" aria-label="Breadcrumb"><a href="/">Home</a><span>/</span><a href="/towns/">Towns</a><span>/</span><span>{town.name}</span></nav>
    <header class="space-y-4 max-w-3xl">
      <h1 class="text-4xl font-display font-bold">Drink shops in {town.name}</h1>
      <p>Compare bubble tea, coffee and juice outlets in {town.name}. Open a listing for its address and recorded opening hours, or use the mall and MRT links below to narrow your search.</p>
    </header>
    <table class="w-full max-w-xl text-sm text-left"><caption class="text-left font-semibold mb-3">Listings in this directory</caption><thead><tr><th scope="col" class="p-3 border-b">Type</th><th scope="col" class="p-3 border-b">Outlets listed</th></tr></thead><tbody>{sections.map(section => <tr><th scope="row" class="p-3 border-b"><a class="underline" href={`#${section.id}`}>{section.title}</a></th><td class="p-3 border-b">{section.venues.length}</td></tr>)}</tbody></table>
    <div class="grid md:grid-cols-3 gap-6">
      {[{ title: 'Brands', links: brandLinks }, { title: 'Malls and locations', links: mallLinks }, { title: 'MRT stations', links: stationLinks }].map(group => group.links.length > 0 && <section class="space-y-3"><h2 class="text-lg font-semibold">{group.title}</h2><ul class="space-y-2">{group.links.map(link => <li><a class="underline" href={link.href}>{link.label}</a></li>)}</ul></section>)}
    </div>
    <aside class="rounded-lg bg-[var(--color-cream-100)] p-5 space-y-2"><h2 class="font-semibold">Check before visiting</h2><p>These are directory listings, not a ranking or a record of visits. Outlets can close, move or change their hours. Confirm details with the shop before travelling, and check its current menu when ordering.</p><a class="underline" href="/contact/">Report an incorrect listing</a></aside>
    {sections.map(section => <section id={section.id} class="space-y-5 scroll-mt-24"><h2 class="text-2xl font-display font-semibold">{section.title} in {town.name}</h2>{section.venues.length > 0 ? <div class="grid sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-5">{section.venues.map(outlet => <ListingCard outlet={outlet} />)}</div> : <p>No {section.title.toLowerCase()} outlets are listed here. <a class="underline" href="/directory/">Browse the full directory</a>.</p>}</section>)}
    <section class="space-y-3"><h2 class="text-xl font-display font-semibold">Browse another town</h2><div class="flex flex-wrap gap-3">{allTowns.filter(item => item.slug !== town.slug).slice(0,12).map(item => <a class="underline" href={`/towns/${item.slug}/`}>{item.name}</a>)}</div></section>
  </section>
</Layout>
