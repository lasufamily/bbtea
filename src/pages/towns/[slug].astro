---
import Layout from '../../components/Layout.astro';
import ListingCard from '../../components/ListingCard.astro';
import { getCoffeeOutlets, getJuiceOutlets, getOutlets, getTowns, getAllVenueTowns } from '../../lib/airtable';
import { formatNumber, parseTownList } from '../../lib/townContent';
import type { Town } from '../../lib/types';

export async function getStaticPaths() {
  const [allOutlets, coffeeOutlets, juiceOutlets, towns] = await Promise.all([getOutlets(), getCoffeeOutlets(), getJuiceOutlets(), getTowns()]);
  const activeTowns = getAllVenueTowns([...allOutlets, ...coffeeOutlets, ...juiceOutlets], [], towns);

  return activeTowns.map(town => {
    const outlets = allOutlets.filter(o => o.townSlug === town.slug);
    const coffee = coffeeOutlets.filter(o => o.townSlug === town.slug);
    const juice = juiceOutlets.filter(o => o.townSlug === town.slug);
    return {
      params: { slug: town.slug },
      props:  { town, outlets, coffeeOutlets: coffee, juiceOutlets: juice, allTowns: activeTowns },
    };
  });
}

interface Props {
  town: Town;
  outlets: Awaited<ReturnType<typeof getOutlets>>;
  coffeeOutlets: Awaited<ReturnType<typeof getCoffeeOutlets>>;
  juiceOutlets: Awaited<ReturnType<typeof getJuiceOutlets>>;
  allTowns: Town[];
}
const { town, outlets, coffeeOutlets, juiceOutlets, allTowns } = Astro.props;
const venueCount = outlets.length + coffeeOutlets.length + juiceOutlets.length;

// Unique brands in this town
const brandSet = [...new Set([...outlets, ...coffeeOutlets, ...juiceOutlets].map(o => o.brandName).filter(Boolean))];
const knownFor = town.knownFor ?? [];
const mrtLines = town.mrtLines ?? [];
const descriptionParagraphs = town.description?.split(/\n+/).map(p => p.trim()).filter(Boolean) ?? [];
const population = formatNumber(town.population);
const townContext = [town.region, town.planningArea].filter(Boolean).join(' · ');

const guideSections = [
  {
    title: 'Food Scene',
    eyebrow: town.foodSceneVibe,
    groups: [
      { title: 'Famous Hawker Centres', items: parseTownList(town.famousHawkerCentres) },
      { title: 'Michelin-Recommended Stalls', items: parseTownList(town.michelinRecommendedStalls) },
      { title: 'Late-Night Food Spots', items: parseTownList(town.lateNightFoodSpots) },
    ],
  },
  {
    title: 'Things To Do',
    groups: [
      { title: 'Landmarks', items: parseTownList(town.topLandmarks) },
      { title: 'Parks and Green Spaces', items: parseTownList(town.parksAndGreenSpaces) },
      { title: 'Malls and Shopping', items: parseTownList(town.mallsAndShopping) },
      { title: 'Sports and Recreation', items: parseTownList(town.sportsAndRecreation) },
    ],
  },
  {
    title: 'Local Character',
    groups: [
      { title: 'Neighbourhood Vibe', items: parseTownList(town.neighbourhoodVibe) },
      { title: 'Arts and Culture', items: parseTownList(town.artsAndCulture) },
      { title: 'Heritage Sites', items: parseTownList(town.heritageSites) },
      { title: 'Annual Events and Festivals', items: parseTownList(town.annualEventsAndFestivals) },
      { title: 'Nightlife', items: parseTownList(town.nightlife) },
    ],
  },
  {
    title: 'Practical Tips',
    groups: [
      { title: 'Local Tips', items: parseTownList(town.localTips) },
      { title: 'Supermarkets and Wet Markets', items: parseTownList(town.supermarketsAndWetMarkets) },
      { title: 'Notable Schools', items: parseTownList(town.notableSchools) },
      { title: 'Hospitals and Polyclinics', items: parseTownList(town.hospitalsAndPolyclinics) },
      { title: 'Religious Buildings', items: parseTownList(town.religiousBuildings) },
    ],
  },
  {
    title: 'Getting Around',
    groups: [
      { title: 'Key MRT Stations', items: parseTownList(town.keyMrtStations) },
      { title: 'Bus Interchange', items: parseTownList(town.dedicatedBusInterchange) },
      { title: 'Expressway Access', items: parseTownList(town.expresswayAccess) },
    ],
  },
].map(section => ({
  ...section,
  groups: section.groups.filter(group => group.items.length > 0),
})).filter(section => section.groups.length > 0);

const metaDescription = town.tagline
  ? `${town.tagline} Find ${outlets.length} bubble tea shops, ${coffeeOutlets.length} coffee shops and ${juiceOutlets.length} juice shops in ${town.name}, with local food, transport, parks and neighbourhood tips.`
  : `Discover ${outlets.length} bubble tea shops, ${coffeeOutlets.length} coffee shops and ${juiceOutlets.length} juice shops in ${town.name}, Singapore, plus local food, transport, parks and neighbourhood tips.`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CollectionPage',
      '@id': `https://bbtea.sg/towns/${town.slug}/#page`,
      name: `Best Bubble Tea Shops in ${town.name}, Singapore`,
      description: metaDescription,
      url: `https://bbtea.sg/towns/${town.slug}/`,
      isPartOf: { '@id': 'https://bbtea.sg/#website' },
      about: {
        '@type': 'Place',
        name: `${town.name}, Singapore`,
      },
      mainEntity: { '@id': `https://bbtea.sg/towns/${town.slug}/#outlets` },
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `https://bbtea.sg/towns/${town.slug}/#breadcrumb`,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://bbtea.sg/' },
        { '@type': 'ListItem', position: 2, name: 'Towns', item: 'https://bbtea.sg/towns/' },
        { '@type': 'ListItem', position: 3, name: town.name, item: `https://bbtea.sg/towns/${town.slug}/` },
      ],
    },
    {
      '@type': 'ItemList',
      '@id': `https://bbtea.sg/towns/${town.slug}/#outlets`,
      name: `Bubble tea, coffee and juice shops in ${town.name}`,
      numberOfItems: venueCount,
      itemListElement: [...outlets, ...coffeeOutlets, ...juiceOutlets].map((outlet, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        url: 'path' in outlet ? `https://bbtea.sg${outlet.path}` : `https://bbtea.sg/bubble-tea-shops/${outlet.slug}/`,
        name: outlet.name,
      })),
    },
  ],
};
---

<Layout
  title={`Best Bubble Tea Shops in ${town.name} | BBTea.sg`}
  description={metaDescription}
  canonical={`https://bbtea.sg/towns/${town.slug}/`}
  jsonLd={jsonLd}
>

  <!-- Page hero -->
  <section class="bg-white border-b border-[var(--color-stone-200)] py-12 lg:py-16">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 space-y-7" data-pagefind-body>
      <nav class="text-sm text-[var(--color-stone-400)] flex items-center gap-1.5" aria-label="Breadcrumb">
        <a href="/" class="hover:text-[var(--color-forest-700)] transition-colors">Home</a>
        <span>/</span>
        <a href="/towns/" class="hover:text-[var(--color-forest-700)] transition-colors text-[var(--color-stone-700)]">Towns</a>
        <span>/</span>
        <span class="text-[var(--color-stone-700)] font-medium">{town.name}</span>
      </nav>

      <div class="grid lg:grid-cols-[1fr_20rem] gap-8 lg:gap-12 items-start">
        <div class="space-y-5">
          <div class="space-y-2">
            <p class="text-xs font-semibold tracking-[0.2em] uppercase text-[var(--color-forest-700)]">
              {townContext || `${town.name} · Singapore`}
            </p>
            <h1 class="text-3xl lg:text-5xl font-display font-bold leading-tight">
              Best Bubble Tea Shops in {town.name}
            </h1>
            {town.tagline && (
              <p class="text-lg lg:text-xl text-[var(--color-stone-700)] font-medium max-w-3xl">
                {town.tagline}
              </p>
            )}
          </div>

          {descriptionParagraphs.length > 0 && (
            <div class="space-y-4 text-[var(--color-stone-600)] text-base leading-relaxed max-w-3xl">
              {descriptionParagraphs.map(paragraph => <p>{paragraph}</p>)}
            </div>
          )}
        </div>

        <aside class="bg-[var(--color-cream-100)] border border-[var(--color-stone-200)] rounded-lg p-5 space-y-4">
          <h2 class="text-sm font-semibold tracking-[0.16em] uppercase text-[var(--color-stone-500)]">
            At a Glance
          </h2>
          <dl class="space-y-3 text-sm">
            <div class="flex justify-between gap-4">
              <dt class="text-[var(--color-stone-500)]">Bubble tea shops</dt>
              <dd class="font-semibold text-[var(--color-stone-900)]">{outlets.length}</dd>
            </div>
            <div class="flex justify-between gap-4">
              <dt class="text-[var(--color-stone-500)]">Coffee shops</dt>
              <dd class="font-semibold text-[var(--color-stone-900)]">{coffeeOutlets.length}</dd>
            </div>
            <div class="flex justify-between gap-4">
              <dt class="text-[var(--color-stone-500)]">Juice shops</dt>
              <dd class="font-semibold text-[var(--color-stone-900)]">{juiceOutlets.length}</dd>
            </div>
            <div class="flex justify-between gap-4">
              <dt class="text-[var(--color-stone-500)]">Brands listed</dt>
              <dd class="font-semibold text-[var(--color-stone-900)]">{brandSet.length}</dd>
            </div>
            {town.foodSceneVibe && (
              <div class="flex justify-between gap-4">
                <dt class="text-[var(--color-stone-500)]">Food scene</dt>
                <dd class="font-semibold text-[var(--color-stone-900)] text-right">{town.foodSceneVibe}</dd>
              </div>
            )}
            {population && (
              <div class="flex justify-between gap-4">
                <dt class="text-[var(--color-stone-500)]">Population</dt>
                <dd class="font-semibold text-[var(--color-stone-900)]">{population}</dd>
              </div>
            )}
            {town.establishedYear && (
              <div class="flex justify-between gap-4">
                <dt class="text-[var(--color-stone-500)]">Established</dt>
                <dd class="font-semibold text-[var(--color-stone-900)]">{town.establishedYear}</dd>
              </div>
            )}
            {town.parkingAvailability && (
              <div class="flex justify-between gap-4">
                <dt class="text-[var(--color-stone-500)]">Parking</dt>
                <dd class="font-semibold text-[var(--color-stone-900)]">{town.parkingAvailability}</dd>
              </div>
            )}
            {town.travelTimeToCbd && (
              <div class="pt-3 border-t border-[var(--color-stone-200)]">
                <dt class="text-[var(--color-stone-500)] mb-1">CBD travel time</dt>
                <dd class="font-medium text-[var(--color-stone-800)] leading-snug">{town.travelTimeToCbd}</dd>
              </div>
            )}
          </dl>
        </aside>
      </div>

      <!-- Quick stats -->
      <div class="flex flex-wrap items-center gap-2 pt-1">
        {knownFor.map(tag => (
          <span class="text-xs px-3 py-1.5 rounded-lg bg-[var(--color-cream-100)] border border-[var(--color-stone-200)] text-[var(--color-stone-700)] font-medium">
            {tag}
          </span>
        ))}
        {mrtLines.map(line => (
          <span class="text-xs px-3 py-1.5 rounded-lg bg-white border border-[var(--color-stone-200)] text-[var(--color-forest-700)] font-semibold">
            {line}
          </span>
        ))}
      </div>
    </div>
  </section>

  <!-- Bubble tea listings -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 lg:py-14" data-pagefind-body>
    <div class="max-w-3xl space-y-3 mb-8">
      <p class="text-xs font-semibold tracking-[0.2em] uppercase text-[var(--color-forest-700)]">
        Bubble Tea in {town.name}
      </p>
      <h2 class="text-2xl lg:text-3xl font-display font-semibold text-[var(--color-stone-900)]">
        Where to get boba around {town.name}
      </h2>
      <p class="text-[var(--color-stone-600)] leading-relaxed">
        This guide lists {outlets.length} {outlets.length === 1 ? 'bubble tea shop' : 'bubble tea shops'} across {brandSet.length} {brandSet.length === 1 ? 'brand' : 'brands'} in {town.name}, alongside the local food, transport and neighbourhood context that makes the area easier to explore.
        {coffeeOutlets.length > 0 && ` It also includes ${coffeeOutlets.length} ${coffeeOutlets.length === 1 ? 'coffee outlet' : 'coffee outlets'} from your Airtable Coffee Shops table.`}
        {juiceOutlets.length > 0 && ` You will also find ${juiceOutlets.length} ${juiceOutlets.length === 1 ? 'juice outlet' : 'juice outlets'} from your Airtable Juice Shops table.`}
      </p>
      <div class="flex flex-wrap items-center gap-6 pt-2">
        <div class="text-sm">
          <span class="font-bold text-xl">{outlets.length}</span>
          <span class="text-[var(--color-stone-400)] ml-1">{outlets.length === 1 ? 'shop' : 'shops'}</span>
        </div>
        {brandSet.length > 0 && (
          <div class="text-sm">
            <span class="font-bold text-xl">{brandSet.length}</span>
            <span class="text-[var(--color-stone-400)] ml-1">{brandSet.length === 1 ? 'brand' : 'brands'}</span>
          </div>
        )}
      </div>
    </div>

    {brandSet.length > 0 && (
      <div class="flex flex-wrap gap-2 mb-8">
        <span class="text-xs font-semibold text-[var(--color-stone-400)] self-center mr-1">Brands:</span>
        {brandSet.map(b => (
          <span class="text-xs px-3 py-1.5 rounded-lg bg-[var(--color-cream-100)] border border-[var(--color-stone-200)] text-[var(--color-stone-600)] font-medium">
            {b}
          </span>
        ))}
      </div>
    )}

    {outlets.length > 0 ? (
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-5">
        {outlets.map(outlet => <ListingCard outlet={outlet} />)}
      </div>
    ) : (
      <div class="text-center py-20 space-y-4">
        <p class="text-sm font-semibold tracking-[0.2em] uppercase text-[var(--color-stone-400)]">No Results</p>
        <h2 class="text-xl font-display font-semibold text-[var(--color-stone-800)]">
          No shops listed in {town.name} yet
        </h2>
        <p class="text-[var(--color-stone-500)] max-w-sm mx-auto">
          We're growing our directory. Check back soon or browse all available shops.
        </p>
        <a href="/directory/" class="inline-flex items-center gap-2 mt-2 px-6 py-3 rounded-lg bg-[var(--color-forest-700)] text-white text-sm font-semibold hover:bg-white hover:text-[var(--color-forest-700)] border border-[var(--color-forest-700)] transition-colors">
          Browse All Shops
        </a>
      </div>
    )}
  </section>

  {coffeeOutlets.length > 0 && (
    <section class="bg-[var(--color-cream-100)] border-y border-[var(--color-stone-200)] py-12 lg:py-14" data-pagefind-body>
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-6">
        <div class="max-w-3xl space-y-3">
          <p class="text-xs font-semibold tracking-[0.2em] uppercase text-[var(--color-forest-700)]">
            Coffee in {town.name}
          </p>
          <h2 class="text-2xl lg:text-3xl font-display font-semibold text-[var(--color-stone-900)]">
            Coffee outlets around {town.name}
          </h2>
          <p class="text-[var(--color-stone-600)] leading-relaxed">
            These coffee listings are pulled from your Airtable Coffee Shops table and linked to the same town, mall and MRT records as the rest of the directory.
          </p>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-5">
          {coffeeOutlets.map(outlet => <ListingCard outlet={outlet} />)}
        </div>
      </div>
    </section>
  )}

  {juiceOutlets.length > 0 && (
    <section class="bg-white border-y border-[var(--color-stone-200)] py-12 lg:py-14" data-pagefind-body>
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-6">
        <div class="max-w-3xl space-y-3">
          <p class="text-xs font-semibold tracking-[0.2em] uppercase text-[var(--color-forest-700)]">
            Juice in {town.name}
          </p>
          <h2 class="text-2xl lg:text-3xl font-display font-semibold text-[var(--color-stone-900)]">
            Juice outlets around {town.name}
          </h2>
          <p class="text-[var(--color-stone-600)] leading-relaxed">
            These juice listings are pulled from your Airtable Juice Shops table and linked to the same town, mall and MRT records as the rest of the directory.
          </p>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-5">
          {juiceOutlets.map(outlet => <ListingCard outlet={outlet} />)}
        </div>
      </div>
    </section>
  )}

  <!-- Local guide -->
  {guideSections.length > 0 && (
    <section class="bg-[var(--color-cream-100)] border-y border-[var(--color-stone-200)] py-12 lg:py-16" data-pagefind-body>
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-10">
        <div class="max-w-3xl space-y-3">
          <p class="text-xs font-semibold tracking-[0.2em] uppercase text-[var(--color-forest-700)]">
            Local Guide
          </p>
          <h2 class="text-2xl lg:text-3xl font-display font-semibold">
            What to know before exploring {town.name}
          </h2>
          <p class="text-[var(--color-stone-600)] leading-relaxed">
            Use these notes as a local-first companion to the shop listings, especially if you are planning food stops, a weekend walk, or a quick drink run around the area.
          </p>
        </div>

        <div class="space-y-8">
          {guideSections.map(section => (
            <article class="bg-white border border-[var(--color-stone-200)] rounded-lg p-5 lg:p-7 space-y-5">
              <div class="flex flex-wrap items-end justify-between gap-3">
                <h3 class="text-xl lg:text-2xl font-display font-semibold">{section.title}</h3>
                {section.eyebrow && (
                  <span class="text-xs px-3 py-1.5 rounded-lg bg-[var(--color-cream-100)] border border-[var(--color-stone-200)] text-[var(--color-stone-600)] font-semibold">
                    {section.eyebrow}
                  </span>
                )}
              </div>

              <div class="grid md:grid-cols-2 xl:grid-cols-3 gap-5">
                {section.groups.map(group => (
                  <div class="space-y-3">
                    <h4 class="text-sm font-semibold tracking-[0.12em] uppercase text-[var(--color-stone-500)]">
                      {group.title}
                    </h4>
                    <div class="space-y-3">
                      {group.items.map(item => (
                        <div class="text-sm leading-relaxed text-[var(--color-stone-600)] border-t border-[var(--color-stone-100)] pt-3 first:border-t-0 first:pt-0">
                          {item.title && <p class="font-semibold text-[var(--color-stone-900)]">{item.title}</p>}
                          {item.description && <p>{item.description}</p>}
                        </div>
                      ))}
                    </div>
                  </div>
                ))}
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Neighbouring towns -->
  <section class="bg-white border-t border-[var(--color-stone-200)] py-12">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-6">
      <h2 class="text-xl font-display font-semibold text-[var(--color-stone-900)]">
        Explore Other Towns
      </h2>
      <div class="flex flex-wrap gap-2">
        {allTowns.filter(t => t.slug !== town.slug).map(t => (
          <a
            href={`/towns/${t.slug}/`}
            class="text-sm px-4 py-2 rounded-lg bg-white border border-[var(--color-stone-200)] text-[var(--color-stone-600)] hover:border-[var(--color-forest-700)] hover:text-[var(--color-forest-700)] transition-colors font-medium"
          >
            {t.name}
          </a>
        ))}
      </div>
    </div>
  </section>

</Layout>
