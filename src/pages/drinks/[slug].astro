---
import Layout from '../../components/Layout.astro';
import DrinkCard from '../../components/DrinkCard.astro';
import { getDrinks } from '../../lib/airtable';
import { pathSegment } from '../../lib/url';
import type { Drink } from '../../lib/types';

export async function getStaticPaths() {
  const drinks = await getDrinks();
  return drinks.map(drink => ({
    params: { slug: drink.slug },
    props:  { drink },
  }));
}

interface Props {
  drink: Drink;
}

const { drink } = Astro.props;
const allDrinks = await getDrinks();
const relatedDrinks = allDrinks
  .filter(item => item.slug !== drink.slug && item.categorySlug === drink.categorySlug)
  .slice(0, 4);

const priceRows = [
  { label: 'Medium', value: drink.priceM },
  { label: 'Large', value: drink.priceL },
  { label: '1 litre', value: drink.priceOneLitre },
].filter(row => typeof row.value === 'number');

const brandNames = drink.brands.map(brand => brand.name).join(', ');
const calorieRows = [
  { label: 'Medium cup', value: drink.caloriesM },
  { label: 'Large cup', value: drink.caloriesL },
  { label: 'Per 100ml', value: drink.caloriesPer100ml },
].filter(row => row.value);
const descriptionCalories = drink.caloriesM ?? drink.caloriesL ?? drink.caloriesPer100ml ?? drink.calories;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: drink.name,
  description: drink.description ?? `${drink.name}${brandNames ? ` by ${brandNames}` : ''}.`,
  category: drink.category,
  ...(drink.image && { image: drink.image }),
  ...(drink.brands.length === 1 && { brand: { '@type': 'Brand', name: drink.brands[0].name } }),
  ...(priceRows[0] && {
    offers: {
      '@type': 'Offer',
      priceCurrency: 'SGD',
      price: priceRows[0].value,
      availability: 'https://schema.org/InStock',
    },
  }),
};
---

<Layout
  title={`${drink.name} in Singapore | BBTea.sg`}
  description={`${drink.name}${brandNames ? ` from ${brandNames}` : ''}. ${drink.category ? `${drink.category}. ` : ''}${descriptionCalories ? `${descriptionCalories} kcal. ` : ''}${drink.description ?? ''}`}
  image={drink.image}
  type="article"
  canonical={`https://bbtea.sg/drinks/${drink.slug}/`}
  jsonLd={jsonLd}
>

  <section class="bg-white border-b border-[var(--color-stone-200)]">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-14 lg:py-18">
      <nav class="text-sm text-[var(--color-stone-400)] mb-8 flex items-center gap-1.5" aria-label="Breadcrumb">
        <a href="/" class="hover:text-[var(--color-stone-900)] transition-colors">Home</a>
        <span>/</span>
        <a href="/drinks/" class="hover:text-[var(--color-stone-900)] transition-colors">Drinks</a>
        <span>/</span>
        <span class="text-[var(--color-stone-700)] font-medium">{drink.name}</span>
      </nav>

      <div class="grid lg:grid-cols-[0.9fr_1.1fr] gap-10 lg:gap-14 items-start">
        <div class="aspect-[4/3] rounded-lg overflow-hidden bg-[var(--color-cream-100)] border border-[var(--color-stone-200)]">
          {drink.image ? (
            <img
              src={drink.image}
              alt={drink.name}
              class="w-full h-full object-cover"
              loading="eager"
              decoding="async"
              width="720"
              height="540"
            />
          ) : (
            <div class="w-full h-full flex items-center justify-center">
              <span class="text-sm font-semibold tracking-wide uppercase text-[var(--color-stone-400)]">Drink</span>
            </div>
          )}
        </div>

        <div class="space-y-6" data-pagefind-body>
          <div class="space-y-3">
            <p class="text-xs font-semibold tracking-[0.2em] uppercase text-[var(--color-forest-700)]">
              {drink.category ?? 'Drink'}
            </p>
            <h1 class="text-3xl lg:text-5xl font-display font-bold leading-tight text-[var(--color-stone-900)]">
              {drink.name}
            </h1>
            {drink.description && (
              <p class="text-[var(--color-stone-600)] text-base leading-relaxed max-w-2xl">
                {drink.description}
              </p>
            )}
          </div>

          <div class="flex flex-wrap gap-2">
            {drink.brands.map(brand => (
              <a
                href={`/brands/${pathSegment(brand.slug)}/`}
                class="inline-flex items-center gap-2 px-3 py-2 rounded-lg bg-[var(--color-cream-100)] text-sm font-semibold text-[var(--color-stone-700)] border border-[var(--color-stone-200)] hover:border-[var(--color-forest-700)] hover:text-[var(--color-forest-700)] transition-colors"
              >
                {brand.logo && (
                  <img src={brand.logo} alt="" class="w-5 h-5 rounded object-cover" loading="lazy" decoding="async" />
                )}
                {brand.name}
              </a>
            ))}
          </div>

          <dl class="grid sm:grid-cols-3 gap-3">
            {priceRows.map(row => (
              <div class="rounded-lg border border-[var(--color-stone-200)] bg-white p-4">
                <dt class="text-xs font-semibold uppercase tracking-wide text-[var(--color-stone-400)]">{row.label}</dt>
                <dd class="mt-1 text-2xl font-display font-semibold text-[var(--color-stone-900)]">
                  ${row.value!.toFixed(2)}
                </dd>
              </div>
            ))}
            {calorieRows.length === 0 && drink.calories && (
              <div class="rounded-lg border border-[var(--color-stone-200)] bg-white p-4">
                <dt class="text-xs font-semibold uppercase tracking-wide text-[var(--color-stone-400)]">Calories</dt>
                <dd class="mt-1 text-base font-semibold text-[var(--color-stone-900)]">{drink.calories} kcal</dd>
              </div>
            )}
            {calorieRows.map(row => (
              <div class="rounded-lg border border-[var(--color-stone-200)] bg-white p-4">
                <dt class="text-xs font-semibold uppercase tracking-wide text-[var(--color-stone-400)]">{row.label}</dt>
                <dd class="mt-1 text-base font-semibold text-[var(--color-stone-900)]">{row.value} kcal</dd>
              </div>
            ))}
            {drink.nutriGrade && (
              <div class="rounded-lg border border-[var(--color-stone-200)] bg-white p-4">
                <dt class="text-xs font-semibold uppercase tracking-wide text-[var(--color-stone-400)]">Nutri-Grade</dt>
                <dd class="mt-1 text-base font-semibold text-[var(--color-stone-900)]">{drink.nutriGrade}</dd>
              </div>
            )}
            {drink.healthierChoice && (
              <div class="rounded-lg border border-[var(--color-stone-200)] bg-white p-4">
                <dt class="text-xs font-semibold uppercase tracking-wide text-[var(--color-stone-400)]">Healthier Choice</dt>
                <dd class="mt-1 text-base font-semibold text-[var(--color-stone-900)]">
                  {drink.healthierChoiceType ?? 'Yes'}
                </dd>
              </div>
            )}
          </dl>
        </div>
      </div>
    </div>
  </section>

  {relatedDrinks.length > 0 && (
    <section class="bg-[var(--color-cream-100)] border-t border-[var(--color-stone-200)] py-14">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-6">
        <div class="flex items-end justify-between gap-4">
          <h2 class="text-xl font-display font-semibold text-[var(--color-stone-900)]">
            More {drink.category} Drinks
          </h2>
          {drink.categorySlug && (
            <a href={`/drinks/?category=${drink.categorySlug}`} class="text-sm font-semibold text-[var(--color-forest-700)] hover:underline">
              View all
            </a>
          )}
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
          {relatedDrinks.map(item => <DrinkCard drink={item} />)}
        </div>
      </div>
    </section>
  )}

</Layout>
