---
import Layout from '../../components/Layout.astro';
import DrinkCard from '../../components/DrinkCard.astro';
import ListingCard from '../../components/ListingCard.astro';
import { getDrinks, getBrands, getOutlets, getCoffeeOutlets, getJuiceOutlets } from '../../lib/airtable';
import { menuLinksForBrands } from '../../lib/internalLinks';
import { pathSegment } from '../../lib/url';
import type { Drink } from '../../lib/types';

export async function getStaticPaths() {
  const drinks = await getDrinks();
  return drinks.map(drink => ({
    params: { slug: drink.slug },
    props:  { drink },
  }));
}

interface Props {
  drink: Drink;
}

const { drink } = Astro.props;
const allDrinks = await getDrinks();
const relatedDrinks = allDrinks
  .filter(item => item.slug !== drink.slug && item.categorySlug === drink.categorySlug)
  .slice(0, 4);
const brandMenuLinks = menuLinksForBrands(drink.brands, 6);

const priceRows = [
  { label: 'Medium', value: drink.priceM },
  { label: 'Large', value: drink.priceL },
  { label: '1 litre', value: drink.priceOneLitre },
].filter(row => typeof row.value === 'number');

const brandNames = drink.brands.map(brand => brand.name).join(', ');
const nutritionRows = [
  { label: 'Calories per 100ml', value: drink.caloriesPer100ml ? `${drink.caloriesPer100ml} kcal` : undefined },
  { label: 'Calories per M cup', value: drink.caloriesM ? `${drink.caloriesM} kcal` : undefined },
  { label: 'Calories per L cup', value: drink.caloriesL ? `${drink.caloriesL} kcal` : undefined },
  ...(!drink.caloriesM && !drink.caloriesL && !drink.caloriesPer100ml && drink.calories
    ? [{ label: 'Calories (serving not specified)', value: `${drink.calories} kcal` }] : []),
  { label: 'Nutri-Grade', value: drink.nutriGrade },
  { label: 'Healthier Choice Type', value: drink.healthierChoiceType },
];
const [brands, outlets, coffeeOutlets, juiceOutlets] = await Promise.all([getBrands(), getOutlets(), getCoffeeOutlets(), getJuiceOutlets()]);
const brandSlugs = new Set(drink.brands.map(brand => brand.slug));
const stockists = [...outlets, ...coffeeOutlets, ...juiceOutlets].filter(outlet => brandSlugs.has(outlet.brandSlug)).slice(0, 8);
const sourceBrands = brands.filter(brand => brandSlugs.has(brand.slug) && brand.websiteUrl);
const description = `${drink.name}${brandNames ? ` from ${brandNames}` : ''}. See prices, calories and nutrition labels where listed, and find brand outlets in Singapore.`;
const jsonLd = {
  '@context': 'https://schema.org', '@type': 'MenuItem',
  name: drink.name, description: drink.description ?? description,
  ...(drink.image && { image: drink.image }),
  url: `https://bbtea.sg/drinks/${drink.slug}/`,
};
---

<Layout
  title={`${drink.name} in Singapore | BBTea.sg`}
  description={description}
  image={drink.image}
  type="article"
  canonical={`https://bbtea.sg/drinks/${drink.slug}/`}
  jsonLd={jsonLd}
>

  <section class="bg-white border-b border-[var(--color-stone-200)]">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-14 lg:py-18">
      <nav class="text-sm text-[var(--color-stone-400)] mb-8 flex items-center gap-1.5" aria-label="Breadcrumb">
        <a href="/" class="hover:text-[var(--color-forest-700)] transition-colors">Home</a>
        <span>/</span>
        <a href="/drinks/" class="hover:text-[var(--color-forest-700)] transition-colors">Drinks</a>
        <span>/</span>
        <span class="text-[var(--color-stone-700)] font-medium">{drink.name}</span>
      </nav>

      <div class="grid lg:grid-cols-[0.9fr_1.1fr] gap-10 lg:gap-14 items-start">
        <div class="aspect-[4/3] rounded-lg overflow-hidden bg-[var(--color-cream-100)] border border-[var(--color-stone-200)]">
          {drink.image ? (
            <img
              src={drink.image}
              alt={drink.name}
              class="w-full h-full object-cover"
              loading="eager"
              decoding="async"
              width="720"
              height="540"
            />
          ) : (
            <div class="w-full h-full flex items-center justify-center">
              <span class="text-sm font-semibold tracking-wide uppercase text-[var(--color-stone-400)]">Drink</span>
            </div>
          )}
        </div>

        <div class="space-y-6" data-pagefind-body>
          <div class="space-y-3">
            <p class="text-xs font-semibold tracking-[0.2em] uppercase text-[var(--color-forest-700)]">
              {drink.category ?? 'Drink'}
            </p>
            <div class="flex items-start gap-3 sm:gap-4">
              <h1 class="text-3xl lg:text-5xl font-display font-bold leading-tight text-[var(--color-stone-900)]">
                {drink.name}
              </h1>
              {drink.healthierChoice && <img src="/healthier-choice-symbol.jpg" alt="Healthier Choice" class="mt-1 h-12 w-12 shrink-0 object-contain" width="48" height="48" loading="eager" decoding="async" />}
            </div>
            {drink.description && (
              <p class="text-[var(--color-stone-600)] text-base leading-relaxed max-w-2xl">
                {drink.description}
              </p>
            )}
          </div>

          <div class="flex flex-wrap gap-2">
            {drink.brands.map(brand => (
              <a
                href={`/brands/${pathSegment(brand.slug)}/`}
                class="inline-flex items-center gap-2 px-3 py-2 rounded-lg bg-[var(--color-cream-100)] text-sm font-semibold text-[var(--color-stone-700)] border border-[var(--color-stone-200)] hover:border-[var(--color-forest-700)] hover:text-[var(--color-forest-700)] transition-colors"
              >
                {brand.logo && (
                  <img src={brand.logo} alt="" class="w-5 h-5 rounded object-cover" loading="lazy" decoding="async" />
                )}
                {brand.name}
              </a>
            ))}
          </div>

          {brandMenuLinks.length > 0 && (
            <div class="space-y-2">
              <h2 class="text-xs font-semibold tracking-[0.16em] uppercase text-[var(--color-stone-400)]">Brand menus</h2>
              <div class="flex flex-wrap gap-2">
                {brandMenuLinks.map(link => (
                  <a href={link.href} class="inline-flex items-center gap-1.5 px-3 py-2 rounded-lg bg-white text-sm font-semibold text-[var(--color-stone-700)] border border-[var(--color-stone-200)] hover:border-[var(--color-forest-700)] hover:text-[var(--color-forest-700)] transition-colors">
                    {link.label}
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"/>
                    </svg>
                  </a>
                ))}
              </div>
            </div>
          )}

          <table class="w-full text-sm text-left"><caption class="text-left font-semibold mb-3">Listed prices (SGD)</caption><thead><tr><th scope="col" class="p-3 border-b">Size</th><th scope="col" class="p-3 border-b">Price</th></tr></thead><tbody>
            {priceRows.map(row => <tr><th scope="row" class="p-3 border-b">{row.label}</th><td class="p-3 border-b">${row.value?.toFixed(2)}</td></tr>)}
          </tbody></table>
          {priceRows.length === 0 && <p>Prices are not recorded for this drink. Check the brand's current menu.</p>}
          <table class="w-full text-sm text-left">
            <caption class="text-left font-semibold mb-3">Nutrition and labels</caption>
            <thead><tr><th scope="col" class="p-3 border-b">Details</th><th scope="col" class="p-3 border-b">Listed value</th></tr></thead>
            <tbody>{nutritionRows.map(row => <tr><th scope="row" class="p-3 border-b">{row.label}</th><td class="p-3 border-b">{row.value ?? 'Not listed'}</td></tr>)}</tbody>
          </table>
          <p class="text-sm text-[var(--color-stone-600)]">Confirm current prices and availability with the shop. Calories and nutrition labels apply to the listed serving; size, sugar level and toppings can change the values.</p>
          {sourceBrands.length > 0 && <div class="space-y-2"><h2 class="font-semibold">Check with the brand</h2><ul>{sourceBrands.map(brand => <li><a href={brand.websiteUrl} class="underline" target="_blank" rel="noopener noreferrer">{brand.name} website</a></li>)}</ul></div>}
          <a href="/contact/" class="underline text-sm">Report a menu correction</a>
        </div>
      </div>
    </div>
  </section>

  {stockists.length > 0 && <section class="max-w-7xl mx-auto px-4 sm:px-6 py-12 space-y-5"><h2 class="text-2xl font-display font-semibold">Find {brandNames} outlets</h2><p>These outlets belong to the listed brand. Check the current menu before travelling for a particular drink.</p><div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-5">{stockists.map(outlet => <ListingCard outlet={outlet} />)}</div></section>}
  {relatedDrinks.length > 0 && (
    <section class="bg-[var(--color-cream-100)] border-t border-[var(--color-stone-200)] py-14">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-6">
        <div class="flex items-end justify-between gap-4">
          <h2 class="text-xl font-display font-semibold text-[var(--color-stone-900)]">
            More {drink.category} Drinks
          </h2>
          {drink.categorySlug && (
            <a href={`/drinks/?category=${drink.categorySlug}`} class="text-sm font-semibold text-[var(--color-forest-700)] hover:underline">
              View all
            </a>
          )}
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
          {relatedDrinks.map(item => <DrinkCard drink={item} />)}
        </div>
      </div>
    </section>
  )}

</Layout>
