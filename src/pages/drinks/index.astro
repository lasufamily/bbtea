---
import Layout from '../../components/Layout.astro';
import CategoryCard from '../../components/CategoryCard.astro';
import { getCategories, getOutlets } from '../../lib/airtable';

const [categories, outlets] = await Promise.all([getCategories(), getOutlets()]);

const categoryOutletCount = (catSlug: string) =>
  outlets.filter(o => o.drinkCategorySlugs?.includes(catSlug)).length;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Bubble Tea Drink Types in Singapore',
  description: `Browse ${categories.length} bubble tea drink categories served at shops across Singapore.`,
  url: 'https://bbtea.sg/drinks',
};
---

<Layout
  title="Bubble Tea Drink Types in Singapore | BBTea.sg"
  description={`Browse all ${categories.length} bubble tea drink types — from classic milk teas and brown sugar boba to matcha, taro, and fruit teas. Find where to get them in Singapore.`}
  canonical="https://bbtea.sg/drinks"
  jsonLd={jsonLd}
>

  <!-- Hero -->
  <section class="bg-white border-b border-[var(--color-stone-200)] py-16">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 space-y-4" data-pagefind-body>
      <nav class="text-sm text-[var(--color-stone-400)] flex items-center gap-1.5" aria-label="Breadcrumb">
        <a href="/" class="hover:text-[var(--color-stone-900)] transition-colors">Home</a>
        <span>/</span>
        <span class="text-[var(--color-stone-700)] font-medium">Drink Types</span>
      </nav>
      <p class="text-xs font-semibold tracking-[0.2em] uppercase text-[var(--color-forest-700)]">
        What Are You Craving?
      </p>
      <h1 class="text-3xl lg:text-5xl font-display font-bold leading-tight">
        Bubble Tea Drink Types
      </h1>
      <p class="text-[var(--color-stone-600)] text-base max-w-2xl leading-relaxed">
        From classic milk teas to indulgent brown sugar creations — find your signature order and the shops that do it best.
      </p>
      <div class="flex flex-wrap items-center gap-6 pt-2">
        <div class="text-sm">
          <span class="font-bold text-xl">{categories.length}</span>
          <span class="text-[var(--color-stone-400)] ml-1">drink types</span>
        </div>
        <div class="text-sm">
          <span class="font-bold text-xl">{outlets.length}</span>
          <span class="text-[var(--color-stone-400)] ml-1">shops listed</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Category grid -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14">
    <h2 class="sr-only">All Bubble Tea Drink Types</h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-5">
      {categories.map(cat => (
        <CategoryCard category={cat} outletCount={categoryOutletCount(cat.slug)} />
      ))}
    </div>
  </section>

</Layout>
