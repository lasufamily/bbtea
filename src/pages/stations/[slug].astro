---
import Layout from '../../components/Layout.astro';
import ListingCard from '../../components/ListingCard.astro';
import { getCoffeeOutlets, getJuiceOutlets, getOutlets, getAllVenueStations } from '../../lib/airtable';
import { topBrandLinks, topMallLinks, topTownLinks } from '../../lib/internalLinks';
import type { MrtStation } from '../../lib/types';

export async function getStaticPaths() {
  const [allOutlets, coffeeOutlets, juiceOutlets] = await Promise.all([getOutlets(), getCoffeeOutlets(), getJuiceOutlets()]);
  const stations = getAllVenueStations([...allOutlets, ...coffeeOutlets, ...juiceOutlets]);

  return stations.map(station => {
    const outlets = allOutlets.filter(o => o.mrtSlug === station.slug);
    const coffee = coffeeOutlets.filter(o => o.mrtSlug === station.slug);
    const juice = juiceOutlets.filter(o => o.mrtSlug === station.slug);
    return {
      params: { slug: station.slug },
      props:  { station, outlets, coffeeOutlets: coffee, juiceOutlets: juice, stations },
    };
  });
}

interface Props {
  station: MrtStation | undefined;
  outlets: Awaited<ReturnType<typeof getOutlets>>;
  coffeeOutlets: Awaited<ReturnType<typeof getCoffeeOutlets>>;
  juiceOutlets: Awaited<ReturnType<typeof getJuiceOutlets>>;
  stations: MrtStation[];
}
const { station, outlets, coffeeOutlets, juiceOutlets, stations } = Astro.props;
const stationName = station?.name ?? Astro.params.slug.replace(/-mrt$/, '').replace(/-/g, ' ').replace(/\b\w/g, (c: string) => c.toUpperCase());
const stationLabel = /\bMRT\b/i.test(stationName) ? stationName : `${stationName} MRT`;
const venueCount = outlets.length + coffeeOutlets.length + juiceOutlets.length;
const stationVenues = [...outlets, ...coffeeOutlets, ...juiceOutlets];
const townLinks = topTownLinks(stationVenues, 4);
const mallLinks = topMallLinks(stationVenues, 6);
const brandLinks = topBrandLinks(stationVenues, 6);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: `Bubble Tea, Coffee and Juice Shops Near ${stationLabel}`,
  description: `Find ${outlets.length} bubble tea shops, ${coffeeOutlets.length} coffee shops and ${juiceOutlets.length} juice shops near ${stationLabel} in Singapore.`,
  url: `https://bbtea.sg/stations/${Astro.params.slug}/`,
};
---

<Layout
  title={`Bubble Tea, Coffee and Juice Near ${stationLabel} | BBTea.sg`}
  description={`Find ${outlets.length} bubble tea shops, ${coffeeOutlets.length} coffee shops and ${juiceOutlets.length} juice shops near ${stationLabel} in Singapore.`}
  canonical={`https://bbtea.sg/stations/${Astro.params.slug}/`}
  jsonLd={jsonLd}
>

  <!-- Header -->
  <section class="bg-white border-b border-[var(--color-stone-200)] py-14">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 space-y-4" data-pagefind-body>
      <nav class="text-sm text-[var(--color-stone-400)] flex items-center gap-1.5" aria-label="Breadcrumb">
        <a href="/" class="hover:text-[var(--color-forest-700)] transition-colors">Home</a>
        <span>/</span>
        <a href="/stations/" class="hover:text-[var(--color-forest-700)] transition-colors">Stations</a>
        <span>/</span>
        <span class="text-[var(--color-stone-700)] font-medium">{stationLabel}</span>
      </nav>

      <div>
        <p class="text-xs font-semibold tracking-[0.2em] uppercase text-[var(--color-forest-700)]">
          Near MRT {station?.line ? `· ${station.line} Line` : ''}
        </p>
        <h1 class="mt-3 text-3xl lg:text-4xl font-display font-bold">
          Bubble Tea, Coffee and Juice Near {stationLabel}
        </h1>
      </div>
      <p class="text-[var(--color-stone-600)] text-base max-w-xl">
        {venueCount} {venueCount === 1 ? 'venue' : 'venues'} close to {stationLabel}, including bubble tea, coffee and juice listings from Airtable.
      </p>
    </div>
  </section>

  {(townLinks.length > 0 || mallLinks.length > 0 || brandLinks.length > 0) && (
    <section class="bg-[var(--color-cream-100)] border-b border-[var(--color-stone-200)] py-8">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid gap-5 lg:grid-cols-3">
        {townLinks.length > 0 && (
          <div class="space-y-3">
            <h2 class="text-xs font-semibold tracking-[0.16em] uppercase text-[var(--color-stone-400)]">Area guides</h2>
            <div class="flex flex-wrap gap-2">
              {townLinks.map(link => (
                <a href={link.href} class="text-xs px-3 py-1.5 rounded-lg bg-white border border-[var(--color-stone-200)] text-[var(--color-stone-600)] hover:border-[var(--color-forest-700)] hover:text-[var(--color-forest-700)] transition-colors font-medium">
                  {link.label}
                </a>
              ))}
            </div>
          </div>
        )}
        {mallLinks.length > 0 && (
          <div class="space-y-3">
            <h2 class="text-xs font-semibold tracking-[0.16em] uppercase text-[var(--color-stone-400)]">Nearby malls</h2>
            <div class="flex flex-wrap gap-2">
              {mallLinks.map(link => (
                <a href={link.href} class="text-xs px-3 py-1.5 rounded-lg bg-white border border-[var(--color-stone-200)] text-[var(--color-stone-600)] hover:border-[var(--color-forest-700)] hover:text-[var(--color-forest-700)] transition-colors font-medium">
                  {link.label}
                </a>
              ))}
            </div>
          </div>
        )}
        {brandLinks.length > 0 && (
          <div class="space-y-3">
            <h2 class="text-xs font-semibold tracking-[0.16em] uppercase text-[var(--color-stone-400)]">Brands near this station</h2>
            <div class="flex flex-wrap gap-2">
              {brandLinks.map(link => (
                <a href={link.href} class="text-xs px-3 py-1.5 rounded-lg bg-white border border-[var(--color-stone-200)] text-[var(--color-stone-600)] hover:border-[var(--color-forest-700)] hover:text-[var(--color-forest-700)] transition-colors font-medium">
                  {link.label}
                </a>
              ))}
            </div>
          </div>
        )}
      </div>
    </section>
  )}

  <!-- Outlets -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    {venueCount > 0 ? (
      <div class="space-y-12">
        {outlets.length > 0 && (
          <section class="space-y-5">
            <h2 class="text-xl font-display font-semibold text-[var(--color-stone-900)]">Bubble Tea Shops</h2>
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-5">
              {outlets.map(outlet => <ListingCard outlet={outlet} />)}
            </div>
          </section>
        )}
        {coffeeOutlets.length > 0 && (
          <section class="space-y-5">
            <h2 class="text-xl font-display font-semibold text-[var(--color-stone-900)]">Coffee Shops</h2>
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-5">
              {coffeeOutlets.map(outlet => <ListingCard outlet={outlet} />)}
            </div>
          </section>
        )}
        {juiceOutlets.length > 0 && (
          <section class="space-y-5">
            <h2 class="text-xl font-display font-semibold text-[var(--color-stone-900)]">Juice Shops</h2>
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-5">
              {juiceOutlets.map(outlet => <ListingCard outlet={outlet} />)}
            </div>
          </section>
        )}
      </div>
    ) : (
      <div class="text-center py-20 space-y-4">
        <p class="text-sm font-semibold tracking-[0.2em] uppercase text-[var(--color-stone-400)]">No Results</p>
        <h2 class="text-xl font-display font-semibold text-[var(--color-stone-800)]">
          No shops near {stationLabel} yet
        </h2>
        <p class="text-[var(--color-stone-500)] max-w-sm mx-auto">
          We're growing our coverage. Browse all shops in the meantime.
        </p>
        <a href="/directory/" class="inline-flex items-center gap-2 mt-2 px-6 py-3 rounded-lg bg-[var(--color-forest-700)] text-white text-sm font-semibold hover:bg-white hover:text-[var(--color-forest-700)] border border-[var(--color-forest-700)] transition-colors">
          Browse All Shops
        </a>
      </div>
    )}
  </div>

  <!-- Other MRT stations -->
  <section class="bg-[var(--color-cream-100)] border-t border-[var(--color-stone-200)] py-12">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-6">
      <div class="flex items-center justify-between gap-4">
        <h2 class="text-xl font-display font-semibold text-[var(--color-stone-900)]">
          Other MRT Stations
        </h2>
        <a href="/stations/" class="text-sm font-semibold text-[var(--color-forest-700)] hover:text-[var(--color-forest-800)] transition-colors">
          View all →
        </a>
      </div>
      <div class="flex flex-wrap gap-2">
        {stations.filter(m => m.slug !== Astro.params.slug).map(m => (
          <a
            href={`/stations/${m.slug}/`}
            class="text-sm px-4 py-2 rounded-lg bg-white border border-[var(--color-stone-200)] text-[var(--color-stone-600)] hover:border-[var(--color-forest-700)] hover:text-[var(--color-forest-700)] transition-colors font-medium"
          >
            {m.name}
          </a>
        ))}
      </div>
    </div>
  </section>

</Layout>
