---
import Layout from '../components/Layout.astro';

const faqs = [
  {
    question: 'What is BBTea.sg?',
    answer: 'BBTea.sg is an independent Singapore directory for bubble tea shops, coffee shops, brands, menus, towns, MRT stations, malls, and halal-friendly listings.',
  },
  {
    question: 'How do you choose which outlets to list?',
    answer: 'We focus on publicly available outlet information from brand sites, store pages, maps, and editorial research. Listings are meant to be practical rather than ranked.',
  },
  {
    question: 'Do you include coffee shops as well as bubble tea shops?',
    answer: 'Yes. BBTea.sg started with bubble tea, but the directory also includes coffee shops and cafes so readers can browse Singapore drink spots in one place.',
  },
  {
    question: 'Can a brand or outlet update its information?',
    answer: 'Yes. Send corrections, new outlet details, menu updates, or removal requests through the contact page and we will review them.',
  },
  {
    question: 'Are halal listings guaranteed?',
    answer: 'Halal information can change, so we list the status available during research and encourage readers to confirm directly with the outlet before visiting.',
  },
  {
    question: 'Can I advertise on BBTea.sg?',
    answer: 'Yes. Brands, agencies, and local businesses can use the advertise page to enquire about sponsored placements and partnerships.',
  },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map(({ question, answer }) => ({
    '@type': 'Question',
    name: question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: answer,
    },
  })),
};
---

<Layout
  title="FAQ | BBTea.sg"
  description="Frequently asked questions about BBTea.sg, including listings, outlet updates, halal information, advertising, and how the Singapore drink directory works."
  canonical="https://bbtea.sg/faq/"
  jsonLd={jsonLd}
>
  <section class="bg-white border-b border-[var(--color-stone-200)] py-16">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 space-y-6">
      <nav class="text-sm text-[var(--color-stone-400)] flex items-center gap-1.5" aria-label="Breadcrumb">
        <a href="/" class="hover:text-[var(--color-forest-700)] transition-colors">Home</a>
        <span>/</span>
        <span class="text-[var(--color-stone-700)] font-medium">FAQ</span>
      </nav>

      <div class="space-y-5 max-w-3xl">
        <p class="text-xs font-semibold tracking-[0.2em] uppercase text-[var(--color-forest-700)]">
          Frequently Asked Questions
        </p>
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-display font-bold leading-tight text-balance">
          Useful answers before your next drink run.
        </h1>
        <p class="text-base lg:text-lg text-[var(--color-stone-600)] leading-relaxed">
          Quick notes on how BBTea.sg works, what we list, and how to send updates when something changes.
        </p>
      </div>
    </div>
  </section>

  <section class="py-14 lg:py-16">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="divide-y divide-[var(--color-stone-200)] border-y border-[var(--color-stone-200)]">
        {faqs.map(faq => (
          <article class="py-7 grid gap-3 lg:grid-cols-[0.42fr_0.58fr] lg:gap-10">
            <h2 class="text-lg font-display font-semibold text-[var(--color-stone-900)]">
              {faq.question}
            </h2>
            <p class="text-sm sm:text-base text-[var(--color-stone-600)] leading-relaxed">
              {faq.answer}
            </p>
          </article>
        ))}
      </div>

      <div class="mt-12 grid sm:grid-cols-3 gap-4">
        <a href="/directory/" class="rounded-lg border border-[var(--color-stone-200)] bg-white p-5 hover:border-[var(--color-forest-700)] transition-colors">
          <span class="text-xs font-semibold tracking-[0.16em] uppercase text-[var(--color-forest-700)]">Browse</span>
          <span class="mt-2 block text-base font-semibold text-[var(--color-stone-900)]">All shops</span>
        </a>
        <a href="/contact/" class="rounded-lg border border-[var(--color-stone-200)] bg-white p-5 hover:border-[var(--color-forest-700)] transition-colors">
          <span class="text-xs font-semibold tracking-[0.16em] uppercase text-[var(--color-forest-700)]">Update</span>
          <span class="mt-2 block text-base font-semibold text-[var(--color-stone-900)]">Send corrections</span>
        </a>
        <a href="/advertise/" class="rounded-lg border border-[var(--color-stone-200)] bg-white p-5 hover:border-[var(--color-forest-700)] transition-colors">
          <span class="text-xs font-semibold tracking-[0.16em] uppercase text-[var(--color-forest-700)]">Partner</span>
          <span class="mt-2 block text-base font-semibold text-[var(--color-stone-900)]">Advertise with us</span>
        </a>
      </div>
    </div>
  </section>
</Layout>
