---
import Layout from '../../components/Layout.astro';
import ListingCard from '../../components/ListingCard.astro';
import { getOutlets } from '../../lib/airtable';
import type { Outlet } from '../../lib/types';

export async function getStaticPaths() {
  const outlets = await getOutlets();
  return outlets.map(outlet => ({
    params: { slug: outlet.slug },
    props:  { outlet },
  }));
}

interface Props { outlet: Outlet }
const { outlet } = Astro.props;

// Related outlets: same town or same brand (excluding self)
const allOutlets    = await getOutlets();
const relatedOutlets = allOutlets
  .filter(o =>
    o.id !== outlet.id &&
    (o.townSlug === outlet.townSlug || o.brandSlug === outlet.brandSlug)
  )
  .slice(0, 3);

// JSON-LD structured data
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FoodEstablishment',
  name: outlet.name,
  description: `${outlet.brandName} bubble tea outlet in ${outlet.town}, Singapore.`,
  address: {
    '@type': 'PostalAddress',
    streetAddress: outlet.address,
    addressLocality: outlet.town,
    addressCountry: 'SG',
  },
  ...(outlet.phone      && { telephone: outlet.phone }),
  ...(outlet.googleMapsUrl && { hasMap: outlet.googleMapsUrl }),
  ...(outlet.openingHours  && { openingHours: outlet.openingHours }),
  ...(outlet.image         && { image: outlet.image }),
  priceRange: outlet.priceRange ?? '$$',
  servesCuisine: 'Bubble Tea',
  url: `https://bubbleteasg.com/shops/${outlet.slug}`,
};

const priceLabel: Record<string, string> = { '$': 'Budget', '$$': 'Mid-range', '$$$': 'Premium' };
---

<Layout
  title={`${outlet.name} — ${outlet.brandName} in ${outlet.town} | Bubble Tea SG`}
  description={`${outlet.name} is a ${outlet.brandName} bubble tea shop located at ${outlet.mall ?? outlet.address}, ${outlet.town}. ${outlet.popularDrinks?.slice(0,2).join(', ') ?? ''}`}
  image={outlet.image}
  type="article"
  canonical={`https://bubbleteasg.com/shops/${outlet.slug}`}
  jsonLd={jsonLd}
>

  <!-- Hero image -->
  <div class="relative h-64 sm:h-80 lg:h-[28rem] bg-[var(--color-cream-100)] overflow-hidden border-b border-[var(--color-stone-200)]" data-pagefind-body>
    {outlet.image ? (
      <>
        <img
          src={outlet.image}
          alt={`${outlet.name} — ${outlet.brandName}`}
          class="w-full h-full object-cover opacity-90"
          fetchpriority="high"
          decoding="async"
          width="1600"
          height="600"
          onerror="this.style.display='none';this.nextElementSibling.style.display='flex'"
        />
        <div class="w-full h-full absolute inset-0 items-center justify-center bg-[var(--color-cream-100)]" style="display:none">
          <span class="text-sm font-semibold tracking-wide uppercase text-[var(--color-stone-400)]">Shop</span>
        </div>
      </>
    ) : (
      <div class="w-full h-full flex items-center justify-center bg-[var(--color-cream-100)]">
        <span class="text-sm font-semibold tracking-wide uppercase text-[var(--color-stone-400)]">Shop</span>
      </div>
    )}
    <div class="absolute inset-0 bg-gradient-to-t from-[var(--color-stone-900)]/70 via-transparent to-transparent"></div>

    <!-- Breadcrumb overlaid on image -->
    <nav class="absolute top-6 left-4 sm:left-8 flex items-center gap-1.5 text-white/80 text-sm" aria-label="Breadcrumb">
      <a href="/" class="hover:text-white transition-colors">Home</a>
      <span>/</span>
      <a href="/directory" class="hover:text-white transition-colors">Directory</a>
      <span>/</span>
      <a href={`/towns/${outlet.townSlug}`} class="hover:text-white transition-colors">{outlet.town}</a>
      <span>/</span>
      <span class="text-white font-medium truncate max-w-[140px]">{outlet.name}</span>
    </nav>
  </div>

  <!-- Main content -->
  <article class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-10 lg:py-14">
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-10">

      <!-- Left: main details -->
      <div class="lg:col-span-2 space-y-8" data-pagefind-body>

        <!-- Header -->
        <header class="space-y-3">
          <div class="flex items-center gap-2 flex-wrap">
            <a
              href={`/brands/${outlet.brandSlug}`}
              class="text-xs font-bold tracking-[0.15em] uppercase text-[var(--color-forest-700)] hover:text-[var(--color-forest-800)] transition-colors"
            >
              {outlet.brandName}
            </a>
            {outlet.featured && (
              <span class="text-[10px] font-bold tracking-widest uppercase px-2 py-0.5 rounded-lg bg-[var(--color-boba-400)]/10 text-[var(--color-boba-500)]">
                Featured
              </span>
            )}
            {outlet.halalFriendly && (
              <span class="text-[10px] font-bold px-2 py-0.5 rounded-lg bg-green-50 text-green-700 border border-green-200">
                Halal-friendly
              </span>
            )}
          </div>
          <h1 class="text-3xl lg:text-4xl font-display font-bold text-[var(--color-stone-900)]">
            {outlet.name}
          </h1>
          <p class="text-[var(--color-stone-500)] text-sm flex items-center gap-1.5">
            <svg class="w-4 h-4 text-[var(--color-stone-400)]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
            </svg>
            <a href={`/towns/${outlet.townSlug}`} class="hover:text-[var(--color-forest-700)] transition-colors font-medium">{outlet.town}</a>
            {outlet.mall && <> · {outlet.mall}</>}
          </p>
        </header>

        <!-- Popular Drinks -->
        {outlet.popularDrinks && outlet.popularDrinks.length > 0 && (
          <section class="space-y-4">
            <h2 class="text-lg font-display font-semibold text-[var(--color-stone-900)]">Popular Drinks</h2>
            <ul class="flex flex-wrap gap-2">
              {outlet.popularDrinks.map(drink => (
                <li class="px-4 py-2 rounded-lg bg-[var(--color-cream-100)] border border-[var(--color-cream-200)] text-sm text-[var(--color-stone-700)] font-medium">
                  {drink}
                </li>
              ))}
            </ul>
          </section>
        )}

        <!-- Drink Categories -->
        {outlet.drinkCategories && outlet.drinkCategories.length > 0 && (
          <section class="space-y-3">
            <h2 class="text-lg font-display font-semibold text-[var(--color-stone-900)]">Drink Types</h2>
            <div class="flex flex-wrap gap-2">
              {outlet.drinkCategories.map((cat, i) => (
                <a
                  href={`/drinks/${outlet.drinkCategorySlugs?.[i] ?? ''}`}
                  class="text-xs font-semibold px-3 py-1.5 rounded-lg bg-[var(--color-forest-700)]/10 text-[var(--color-forest-700)] hover:bg-[var(--color-forest-700)]/20 transition-colors"
                >
                  {cat}
                </a>
              ))}
            </div>
          </section>
        )}

        <!-- Gallery -->
        {outlet.galleryImages && outlet.galleryImages.length > 0 && (
          <section class="space-y-4">
            <h2 class="text-lg font-display font-semibold text-[var(--color-stone-900)]">Gallery</h2>
            <div class="grid grid-cols-2 sm:grid-cols-3 gap-3">
              {outlet.galleryImages.map((img, i) => (
                <div class="aspect-square rounded-lg overflow-hidden bg-[var(--color-cream-100)]">
                  <img
                    src={img}
                    alt={`${outlet.name} photo ${i + 1}`}
                    class="w-full h-full object-cover hover:scale-105 transition-transform duration-300"
                    loading="lazy"
                    decoding="async"
                    width="400"
                    height="400"
                  />
                </div>
              ))}
            </div>
          </section>
        )}
      </div>

      <!-- Right: info card -->
      <aside class="space-y-5">
        <div class="bg-white rounded-lg border border-[var(--color-stone-200)] p-6 space-y-5 sticky top-24 shadow-none">

          <!-- Address -->
          <div class="space-y-1.5">
            <h3 class="text-xs font-semibold tracking-wide uppercase text-[var(--color-stone-400)]">Address</h3>
            <p class="text-sm text-[var(--color-stone-700)] leading-relaxed">{outlet.address}</p>
            {outlet.googleMapsUrl && (
              <a
                href={outlet.googleMapsUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1.5 text-sm font-semibold text-[var(--color-forest-700)] hover:text-[var(--color-forest-800)] transition-colors mt-1"
              >
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7"/>
                </svg>
                Open in Google Maps
              </a>
            )}
          </div>

          <hr class="border-[var(--color-stone-100)]" />

          <!-- Nearest MRT -->
          {outlet.nearestMrt && (
            <div class="space-y-1.5">
              <h3 class="text-xs font-semibold tracking-wide uppercase text-[var(--color-stone-400)]">Nearest MRT</h3>
              <a
                href={`/stations/${outlet.mrtSlug}`}
                class="text-sm font-medium text-[var(--color-stone-700)] hover:text-[var(--color-forest-700)] flex items-center gap-1.5 transition-colors"
              >
                <svg class="w-4 h-4 text-[var(--color-stone-400)]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
                </svg>
                {outlet.nearestMrt}
              </a>
            </div>
          )}

          <!-- Opening hours -->
          {outlet.openingHours && (
            <>
              <hr class="border-[var(--color-stone-100)]" />
              <div class="space-y-1.5">
                <h3 class="text-xs font-semibold tracking-wide uppercase text-[var(--color-stone-400)]">Opening Hours</h3>
                <p class="text-sm text-[var(--color-stone-700)] leading-relaxed whitespace-pre-line">{outlet.openingHours}</p>
              </div>
            </>
          )}

          <!-- Phone -->
          {outlet.phone && (
            <>
              <hr class="border-[var(--color-stone-100)]" />
              <div class="space-y-1.5">
                <h3 class="text-xs font-semibold tracking-wide uppercase text-[var(--color-stone-400)]">Phone</h3>
                <a href={`tel:${outlet.phone}`} class="text-sm text-[var(--color-forest-700)] hover:underline">
                  {outlet.phone}
                </a>
              </div>
            </>
          )}

          <!-- Price range -->
          {outlet.priceRange && (
            <>
              <hr class="border-[var(--color-stone-100)]" />
              <div class="space-y-1.5">
                <h3 class="text-xs font-semibold tracking-wide uppercase text-[var(--color-stone-400)]">Price Range</h3>
                <p class="text-sm text-[var(--color-stone-700)]">
                  <span class="font-semibold">{outlet.priceRange}</span> · {priceLabel[outlet.priceRange]}
                </p>
              </div>
            </>
          )}

          <!-- Amenities -->
          <hr class="border-[var(--color-stone-100)]" />
          <div class="space-y-2">
            <h3 class="text-xs font-semibold tracking-wide uppercase text-[var(--color-stone-400)]">Features</h3>
            <div class="flex flex-wrap gap-2">
              {outlet.halalFriendly && (
                <span class="text-xs px-2.5 py-1 rounded-lg bg-green-50 text-green-700 border border-green-100 font-medium">✓ Halal-friendly</span>
              )}
              {outlet.seatingAvailable && (
                <span class="text-xs px-2.5 py-1 rounded-lg bg-[var(--color-cream-100)] text-[var(--color-stone-600)] border border-[var(--color-stone-200)] font-medium">✓ Seating</span>
              )}
              {!outlet.halalFriendly && !outlet.seatingAvailable && (
                <span class="text-xs text-[var(--color-stone-400)]">—</span>
              )}
            </div>
          </div>

          <!-- Delivery links -->
          {outlet.deliveryLinks && outlet.deliveryLinks.length > 0 && (
            <>
              <hr class="border-[var(--color-stone-100)]" />
              <div class="space-y-2">
                <h3 class="text-xs font-semibold tracking-wide uppercase text-[var(--color-stone-400)]">Order Delivery</h3>
                <div class="flex flex-col gap-2">
                  {outlet.deliveryLinks.map(link => (
                    <a
                      href={link.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="flex items-center justify-between px-4 py-2.5 rounded-lg border border-[var(--color-stone-200)] text-sm font-medium text-[var(--color-stone-700)] hover:border-[var(--color-forest-700)] hover:text-[var(--color-forest-700)] transition-colors"
                    >
                      {link.platform}
                      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
                      </svg>
                    </a>
                  ))}
                </div>
              </div>
            </>
          )}
        </div>
      </aside>
    </div>

    <!-- Related shops -->
    {relatedOutlets.length > 0 && (
      <section class="mt-16 pt-12 border-t border-[var(--color-stone-200)] space-y-6">
        <h2 class="text-2xl font-display font-bold text-[var(--color-stone-900)]">
          You Might Also Like
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
          {relatedOutlets.map(o => <ListingCard outlet={o} />)}
        </div>
      </section>
    )}
  </article>

</Layout>
