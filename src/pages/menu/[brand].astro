---
import Layout from '../../components/Layout.astro';
import { getBrands, getDrinks, getDrinksByBrand } from '../../lib/airtable';
import { pathSegment } from '../../lib/url';
import type { Brand, Drink } from '../../lib/types';

export async function getStaticPaths() {
  const [brands, drinks] = await Promise.all([getBrands(), getDrinks()]);
  const brandSlugsWithDrinks = new Set(
    drinks.flatMap(drink => drink.brands.map(brand => brand.slug)),
  );

  return brands
    .filter(brand => brandSlugsWithDrinks.has(brand.slug))
    .map(brand => ({
      params: { brand: brand.slug },
      props:  { brand },
    }));
}

interface Props {
  brand: Brand;
}

type DrinkGroup = {
  category: string;
  categorySlug?: string;
  drinks: Drink[];
};

const { brand } = Astro.props;
const drinks = await getDrinksByBrand(brand.slug);

const groupedDrinks = Array.from(
  drinks.reduce((groups, drink) => {
    const key = drink.categorySlug ?? drink.category ?? 'other-drinks';
    const group = groups.get(key) ?? {
      category: drink.category ?? 'Other Drinks',
      categorySlug: drink.categorySlug,
      drinks: [],
    };

    group.drinks.push(drink);
    groups.set(key, group);
    return groups;
  }, new Map<string, DrinkGroup>()).values(),
)
  .map(group => ({
    ...group,
    drinks: group.drinks.sort((a, b) => a.name.localeCompare(b.name)),
  }))
  .sort((a, b) => a.category.localeCompare(b.category));

const priceText = (drink: Drink) => {
  const prices = [
    typeof drink.priceM === 'number' ? `M $${drink.priceM.toFixed(2)}` : undefined,
    typeof drink.priceL === 'number' ? `L $${drink.priceL.toFixed(2)}` : undefined,
    typeof drink.priceOneLitre === 'number' ? `1L $${drink.priceOneLitre.toFixed(2)}` : undefined,
  ].filter(Boolean);

  return prices.length > 0 ? prices.join(' / ') : 'Price not listed';
};

const nutritionText = (drink: Drink) => {
  const values = [
    drink.caloriesM ? `M ${drink.caloriesM} kcal` : undefined,
    drink.caloriesL ? `L ${drink.caloriesL} kcal` : undefined,
    drink.caloriesPer100ml ? `${drink.caloriesPer100ml} kcal/100ml` : undefined,
  ].filter(Boolean);

  return values.length > 0 ? values.join(' / ') : drink.calories ? `${drink.calories} kcal` : 'Nutrition not listed';
};

const gradeText = (drink: Drink) => {
  const labels = [
    drink.nutriGrade ? `Nutri-Grade ${drink.nutriGrade}` : undefined,
    drink.healthierChoice ? `Healthier Choice${drink.healthierChoiceType ? `: ${drink.healthierChoiceType}` : ''}` : undefined,
  ].filter(Boolean);

  return labels.length > 0 ? labels.join(' / ') : 'Not listed';
};

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Menu',
  name: `${brand.name} Menu`,
  description: `${brand.name} menu in Singapore with prices, calories, Nutri-Grade labels, and Healthier Choice details.`,
  url: `https://bbtea.sg/menu/${brand.slug}/`,
  hasMenuSection: groupedDrinks.map(group => ({
    '@type': 'MenuSection',
    name: group.category,
    hasMenuItem: group.drinks.map(drink => ({
      '@type': 'MenuItem',
      name: drink.name,
      description: drink.description,
      ...(drink.priceM && {
        offers: {
          '@type': 'Offer',
          priceCurrency: 'SGD',
          price: drink.priceM,
        },
      }),
    })),
  })),
};
---

<Layout
  title={`${brand.name} Menu Singapore | Prices & Calories | BBTea.sg`}
  description={`Browse the ${brand.name} menu in Singapore. See drinks grouped by category with prices, calories, Nutri-Grade labels, and Healthier Choice details.`}
  image={brand.logo}
  type="article"
  canonical={`https://bbtea.sg/menu/${brand.slug}/`}
  jsonLd={jsonLd}
>

  <section class="bg-[var(--color-cream-100)] border-b border-[var(--color-stone-200)] py-14">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="text-sm text-[var(--color-stone-400)] mb-6 flex items-center gap-1.5" aria-label="Breadcrumb">
        <a href="/" class="hover:text-[var(--color-stone-700)] transition-colors">Home</a>
        <span>/</span>
        <a href="/menus/" class="hover:text-[var(--color-stone-700)] transition-colors">Menus</a>
        <span>/</span>
        <span class="text-[var(--color-stone-700)] font-medium">{brand.name}</span>
      </nav>

      <div class="flex items-start gap-6">
        {brand.logo && (
          <div class="w-16 h-16 lg:w-20 lg:h-20 rounded-lg overflow-hidden border border-[var(--color-stone-200)] bg-white flex-shrink-0 shadow-none">
            <img
              src={brand.logo}
              alt={`${brand.name} logo`}
              class="w-full h-full object-cover"
              loading="eager"
              decoding="async"
              width="80"
              height="80"
            />
          </div>
        )}
        <div class="space-y-3 flex-1" data-pagefind-body>
          <p class="text-xs font-semibold tracking-[0.2em] uppercase text-[var(--color-forest-700)]">Menu</p>
          <h1 class="text-3xl lg:text-5xl font-display font-bold text-[var(--color-stone-900)] leading-tight">
            {brand.name} Menu
          </h1>
          <p class="text-[var(--color-stone-600)] text-base leading-relaxed max-w-2xl">
            Browse {brand.name} drinks by category with listed prices, calories, Nutri-Grade labels, and Healthier Choice details.
          </p>
          <div class="flex flex-wrap items-center gap-x-4 gap-y-2 pt-1">
            <span class="text-sm text-[var(--color-stone-500)]">
              {drinks.length} drink{drinks.length !== 1 ? 's' : ''}
            </span>
            <span class="text-sm text-[var(--color-stone-500)]">
              {groupedDrinks.length} categor{groupedDrinks.length === 1 ? 'y' : 'ies'}
            </span>
            <a href={`/brands/${pathSegment(brand.slug)}/`} class="text-sm font-medium text-[var(--color-forest-700)] hover:underline">
              View brand profile
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12 space-y-10">
    {groupedDrinks.map(group => (
      <section class="space-y-4" data-pagefind-body>
        <header class="flex flex-wrap items-end justify-between gap-3 border-b border-[var(--color-stone-200)] pb-3">
          <div>
            <p class="text-xs font-semibold tracking-[0.2em] uppercase text-[var(--color-stone-400)]">Category</p>
            <h2 class="text-2xl font-display font-bold text-[var(--color-stone-900)]">{group.category}</h2>
          </div>
          <span class="text-sm text-[var(--color-stone-400)]">
            {group.drinks.length} item{group.drinks.length !== 1 ? 's' : ''}
          </span>
        </header>

        <div class="overflow-hidden rounded-lg border border-[var(--color-stone-200)] bg-white">
          <div class="hidden lg:grid grid-cols-[minmax(0,1.45fr)_170px_220px_190px] gap-4 px-5 py-3 bg-[var(--color-cream-100)] border-b border-[var(--color-stone-200)] text-xs font-semibold tracking-widest uppercase text-[var(--color-stone-500)]">
            <span>Drink</span>
            <span>Price</span>
            <span>Calories</span>
            <span>Grade</span>
          </div>

          <div class="divide-y divide-[var(--color-stone-100)]">
            {group.drinks.map(drink => (
              <article class="grid lg:grid-cols-[minmax(0,1.45fr)_170px_220px_190px] gap-3 lg:gap-4 px-5 py-4">
                <div class="space-y-1">
                  <a href={`/drinks/${drink.slug}/`} class="font-display text-lg font-semibold text-[var(--color-stone-900)] hover:text-[var(--color-forest-700)] transition-colors">
                    {drink.name}
                  </a>
                  {drink.description && (
                    <p class="text-sm text-[var(--color-stone-600)] leading-relaxed">
                      {drink.description}
                    </p>
                  )}
                </div>
                <div>
                  <span class="lg:hidden block text-[11px] font-semibold uppercase tracking-widest text-[var(--color-stone-400)] mb-1">Price</span>
                  <span class="text-sm font-semibold text-[var(--color-stone-800)]">{priceText(drink)}</span>
                </div>
                <div>
                  <span class="lg:hidden block text-[11px] font-semibold uppercase tracking-widest text-[var(--color-stone-400)] mb-1">Calories</span>
                  <span class="text-sm text-[var(--color-stone-600)]">{nutritionText(drink)}</span>
                </div>
                <div>
                  <span class="lg:hidden block text-[11px] font-semibold uppercase tracking-widest text-[var(--color-stone-400)] mb-1">Grade</span>
                  <span class="text-sm text-[var(--color-stone-600)]">{gradeText(drink)}</span>
                </div>
              </article>
            ))}
          </div>
        </div>
      </section>
    ))}
  </section>

</Layout>
