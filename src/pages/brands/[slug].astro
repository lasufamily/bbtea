---
import Layout from '../../components/Layout.astro';
import ListingCard from '../../components/ListingCard.astro';
import DrinkCard from '../../components/DrinkCard.astro';
import { getBrands, getCoffeeOutlets, getDrinksByBrand, getJuiceOutlets, getOutlets } from '../../lib/airtable';
import { pathSegment } from '../../lib/url';
import type { Brand } from '../../lib/types';

export async function getStaticPaths() {
  const brands = await getBrands();
  return brands.map(brand => ({
    params: { slug: brand.slug },
    props:  { brand },
  }));
}

interface Props { brand: Brand }
const { brand } = Astro.props;

const allOutlets = await getOutlets();
const outlets    = allOutlets.filter(o => o.brandSlug === brand.slug);
const allCoffeeOutlets = await getCoffeeOutlets();
const coffeeOutlets = allCoffeeOutlets.filter(o => o.brandSlug === brand.slug);
const allJuiceOutlets = await getJuiceOutlets();
const juiceOutlets = allJuiceOutlets.filter(o => o.brandSlug === brand.slug);
const drinks     = await getDrinksByBrand(brand.slug);
const hasMenuPage = drinks.length > 0;
const venueCount = outlets.length + coffeeOutlets.length + juiceOutlets.length;
const primaryCategory = coffeeOutlets.length > 0 && outlets.length === 0 && juiceOutlets.length === 0
  ? 'Coffee'
  : juiceOutlets.length > 0 && outlets.length === 0 && coffeeOutlets.length === 0
    ? 'Juice'
    : 'Bubble Tea';

const brandLinks = [
  { label: 'Website', url: brand.websiteUrl },
  { label: 'Facebook', url: brand.facebookUrl },
  { label: 'Instagram', url: brand.instagramUrl },
  { label: 'TikTok', url: brand.tiktokUrl },
].filter((link): link is { label: string; url: string } => Boolean(link.url));

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: brand.name,
  description: brand.description,
  url: brand.websiteUrl ?? `https://bbtea.sg/brands/${pathSegment(brand.slug)}`,
  ...(brand.logo && { logo: brand.logo }),
  ...(brandLinks.length > 0 && { sameAs: brandLinks.map(link => link.url) }),
};
---

<Layout
  title={`${brand.name} Outlets in Singapore | BBTea.sg`}
  description={`Find all ${brand.name} outlets in Singapore, including bubble tea, coffee and juice listings where available. ${brand.description ?? ''}`}
  image={brand.logo}
  type="article"
  canonical={`https://bbtea.sg/brands/${pathSegment(brand.slug)}/`}
  jsonLd={jsonLd}
>

  <!-- Header -->
  <section class="bg-[var(--color-cream-100)] border-b border-[var(--color-stone-200)] py-14">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="text-sm text-[var(--color-stone-400)] mb-6 flex items-center gap-1.5" aria-label="Breadcrumb">
        <a href="/" class="hover:text-[var(--color-stone-700)] transition-colors">Home</a>
        <span>/</span>
        <a href="/brands/" class="hover:text-[var(--color-stone-700)] transition-colors">Brands</a>
        <span>/</span>
        <span class="text-[var(--color-stone-700)] font-medium">{brand.name}</span>
      </nav>

      <div class="flex items-start gap-6">
        {brand.logo && (
          <div class="w-16 h-16 lg:w-20 lg:h-20 rounded-lg overflow-hidden border border-[var(--color-stone-200)] bg-white flex-shrink-0 shadow-none">
            <img
              src={brand.logo}
              alt={`${brand.name} logo`}
              class="w-full h-full object-cover"
              loading="eager"
              decoding="async"
              width="80"
              height="80"
            />
          </div>
        )}
        <div class="space-y-2 flex-1" data-pagefind-body>
          <p class="text-xs font-semibold tracking-[0.2em] uppercase text-[var(--color-forest-700)]">Brand</p>
          <h1 class="text-3xl lg:text-4xl font-display font-bold text-[var(--color-stone-900)]">{brand.name}</h1>
          {brand.description && (
            <p class="text-[var(--color-stone-600)] text-base leading-relaxed max-w-2xl">{brand.description}</p>
          )}
          <div class="flex flex-wrap items-center gap-x-4 gap-y-2 pt-2">
            <span class="text-sm text-[var(--color-stone-500)]">
              {venueCount} outlet{venueCount !== 1 ? 's' : ''} in Singapore
            </span>
            {outlets.length > 0 && (
              <span class="text-sm text-[var(--color-stone-500)]">
                {outlets.length} bubble tea outlet{outlets.length !== 1 ? 's' : ''}
              </span>
            )}
            {coffeeOutlets.length > 0 && (
              <span class="text-sm text-[var(--color-stone-500)]">
                {coffeeOutlets.length} coffee outlet{coffeeOutlets.length !== 1 ? 's' : ''}
              </span>
            )}
            {juiceOutlets.length > 0 && (
              <span class="text-sm text-[var(--color-stone-500)]">
                {juiceOutlets.length} juice outlet{juiceOutlets.length !== 1 ? 's' : ''}
              </span>
            )}
            {drinks.length > 0 && (
              <span class="text-sm text-[var(--color-stone-500)]">
                {drinks.length} drink{drinks.length !== 1 ? 's' : ''}
              </span>
            )}
            {hasMenuPage && (
              <a
                href={`/menus/${pathSegment(brand.slug)}/`}
                class="text-sm font-medium text-[var(--color-forest-700)] hover:text-[var(--color-forest-800)] flex items-center gap-1 transition-colors"
              >
                View menu
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                </svg>
              </a>
            )}
            {brandLinks.map(link => (
              <a
                href={link.url}
                target="_blank"
                rel="noopener noreferrer"
                class="text-sm font-medium text-[var(--color-forest-700)] hover:text-[var(--color-forest-800)] flex items-center gap-1 transition-colors"
              >
                {link.label}
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
                </svg>
              </a>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Outlets grid -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    {venueCount > 0 ? (
      <div class="space-y-12">
        {outlets.length > 0 && (
          <section>
        <h2 class="text-xl font-display font-semibold text-[var(--color-stone-900)] mb-6">
          {brand.name} Bubble Tea Locations
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-5">
          {outlets.map(outlet => <ListingCard outlet={outlet} />)}
        </div>
          </section>
        )}
        {coffeeOutlets.length > 0 && (
          <section>
            <h2 class="text-xl font-display font-semibold text-[var(--color-stone-900)] mb-6">
              {brand.name} Coffee Locations
            </h2>
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-5">
              {coffeeOutlets.map(outlet => <ListingCard outlet={outlet} />)}
            </div>
          </section>
        )}
        {juiceOutlets.length > 0 && (
          <section>
            <h2 class="text-xl font-display font-semibold text-[var(--color-stone-900)] mb-6">
              {brand.name} Juice Locations
            </h2>
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-5">
              {juiceOutlets.map(outlet => <ListingCard outlet={outlet} />)}
            </div>
          </section>
        )}
      </div>
    ) : (
      <div class="text-center py-20 space-y-4">
        <p class="text-sm font-semibold tracking-[0.2em] uppercase text-[var(--color-stone-400)]">No Results</p>
        <p class="text-[var(--color-stone-500)]">No {primaryCategory.toLowerCase()} outlets listed yet for {brand.name}.</p>
        <a href="/directory/" class="text-[var(--color-forest-700)] font-medium hover:underline">Browse all shops →</a>
      </div>
    )}
  </div>

  {drinks.length > 0 && (
    <section class="bg-[var(--color-cream-100)] border-t border-[var(--color-stone-200)] py-12">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-6">
        <div class="flex items-end justify-between gap-4">
          <h2 class="text-xl font-display font-semibold text-[var(--color-stone-900)]">
            {brand.name} Drinks
          </h2>
          <a href="/drinks/" class="text-sm font-semibold text-[var(--color-forest-700)] hover:underline">
            Browse all drinks
          </a>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
          {drinks.slice(0, 4).map(drink => <DrinkCard drink={drink} />)}
        </div>
      </div>
    </section>
  )}

</Layout>
