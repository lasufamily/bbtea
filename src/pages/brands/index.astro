---
import Layout from '../../components/Layout.astro';
import BrandCard from '../../components/BrandCard.astro';
import { getBrands, getCoffeeOutlets, getJuiceOutlets, getOutlets } from '../../lib/airtable';

const [brands, outlets, coffeeOutlets, juiceOutlets] = await Promise.all([getBrands(), getOutlets(), getCoffeeOutlets(), getJuiceOutlets()]);

const brandOutletCount = (brandSlug: string) =>
  outlets.filter(o => o.brandSlug === brandSlug).length +
  coffeeOutlets.filter(o => o.brandSlug === brandSlug).length +
  juiceOutlets.filter(o => o.brandSlug === brandSlug).length;

const featuredBrands = brands.filter(b => b.featured);
const categoryOrder = ['Bubble Tea', 'Coffee', 'Juice', 'More brands'];
const categoryCopy = new Map([
  ['Bubble Tea', 'Milk tea, fruit tea, matcha and boba chains with dedicated drink menus.'],
  ['Coffee', 'Coffee-led brands and cafes for espresso, lattes and daily caffeine runs.'],
  ['Juice', 'Juice bars, smoothie counters and fruit-forward refreshment brands.'],
  ['More brands', 'Drink brands still worth browsing while their category details settle in.'],
]);
const brandsByCategory = Array.from(
  brands.reduce((groups, brand) => {
    const category = brand.category ?? 'More brands';
    const group = groups.get(category) ?? [];
    group.push(brand);
    groups.set(category, group);
    return groups;
  }, new Map<string, typeof brands>()),
  ([category, categoryBrands]) => ({
    category,
    description: categoryCopy.get(category) ?? `${category} brands listed on BBTea.sg.`,
    brands: categoryBrands.sort((a, b) => a.name.localeCompare(b.name)),
  }),
).sort((a, b) => {
  const aIndex = categoryOrder.indexOf(a.category);
  const bIndex = categoryOrder.indexOf(b.category);
  if (aIndex !== -1 || bIndex !== -1) {
    return (aIndex === -1 ? Number.MAX_SAFE_INTEGER : aIndex) - (bIndex === -1 ? Number.MAX_SAFE_INTEGER : bIndex);
  }
  return a.category.localeCompare(b.category);
});

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Bubble Tea, Coffee and Juice Brands in Singapore',
  description: `Browse ${brands.length} bubble tea, coffee and juice brands across Singapore.`,
  url: 'https://bbtea.sg/brands/',
};
---

<Layout
  title="Bubble Tea, Coffee and Juice Brands in Singapore | BBTea.sg"
  description={`Explore all ${brands.length} bubble tea, coffee and juice brands in Singapore, from Taiwan-born icons to local favourites, coffee chains and juice bars.`}
  canonical="https://bbtea.sg/brands/"
  jsonLd={jsonLd}
>

  <!-- Hero -->
  <section class="bg-[var(--color-cream-100)] border-b border-[var(--color-stone-200)] py-16">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 space-y-4" data-pagefind-body>
      <nav class="text-sm text-[var(--color-stone-400)] flex items-center gap-1.5" aria-label="Breadcrumb">
        <a href="/" class="hover:text-[var(--color-stone-700)] transition-colors">Home</a>
        <span>/</span>
        <span class="text-[var(--color-stone-700)] font-medium">Brands</span>
      </nav>
      <p class="text-xs font-semibold tracking-[0.2em] uppercase text-[var(--color-forest-700)]">
        The Names You Know
      </p>
      <h1 class="text-3xl lg:text-5xl font-display font-bold text-[var(--color-stone-900)] leading-tight">
        Bubble Tea, Coffee<br />and Juice Brands in Singapore
      </h1>
      <p class="text-[var(--color-stone-600)] text-base max-w-2xl leading-relaxed">
        From Taiwan-born boba icons to modern coffee chains and juice bars — meet the {brands.length} brands shaping drink runs across Singapore.
      </p>
      <div class="flex flex-wrap items-center gap-6 pt-2">
        <div class="text-sm">
          <span class="font-bold text-xl text-[var(--color-stone-900)]">{brands.length}</span>
          <span class="text-[var(--color-stone-400)] ml-1">brands</span>
        </div>
        <div class="text-sm">
          <span class="font-bold text-xl text-[var(--color-stone-900)]">{outlets.length}</span>
          <span class="text-[var(--color-stone-400)] ml-1">bubble tea outlets</span>
        </div>
        <div class="text-sm">
          <span class="font-bold text-xl text-[var(--color-stone-900)]">{coffeeOutlets.length}</span>
          <span class="text-[var(--color-stone-400)] ml-1">coffee outlets</span>
        </div>
        <div class="text-sm">
          <span class="font-bold text-xl text-[var(--color-stone-900)]">{juiceOutlets.length}</span>
          <span class="text-[var(--color-stone-400)] ml-1">juice outlets</span>
        </div>
      </div>
    </div>
  </section>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14 space-y-16">

    <!-- Featured spotlight -->
    {featuredBrands.length > 0 && (
      <section class="space-y-6">
        <header class="space-y-1">
          <p class="text-xs font-semibold tracking-[0.2em] uppercase text-[var(--color-forest-700)]">Partner Spotlight</p>
          <h2 class="text-2xl font-display font-bold text-[var(--color-stone-900)]">Featured Brands</h2>
        </header>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-5 gap-5">
          {featuredBrands.map(brand => (
            <BrandCard brand={brand} outletCount={brandOutletCount(brand.slug)} />
          ))}
        </div>
      </section>
    )}

    <!-- Category discovery -->
    <section class="space-y-8">
      <header class="grid gap-5 lg:grid-cols-[minmax(0,1fr)_auto] lg:items-end">
        <div class="space-y-2">
          <p class="text-xs font-semibold tracking-[0.2em] uppercase text-[var(--color-stone-400)]">Browse by category</p>
          <h2 class="text-2xl lg:text-3xl font-display font-bold text-[var(--color-stone-900)]">Find the right kind of drink brand</h2>
          <p class="text-sm text-[var(--color-stone-600)] max-w-2xl leading-relaxed">
            Brands are grouped by the Category field in Airtable, so bubble tea, coffee and juice names are easier to discover without scanning one long list.
          </p>
        </div>
        <div class="flex flex-wrap gap-2 lg:justify-end">
          {brandsByCategory.map(group => (
            <a
              href={`#${group.category.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '')}`}
              class="text-sm px-3 py-2 rounded-lg border border-[var(--color-stone-200)] bg-white text-[var(--color-stone-600)] hover:border-[var(--color-forest-700)] hover:text-[var(--color-forest-700)] transition-colors font-medium"
            >
              {group.category}
              <span class="text-[var(--color-stone-400)] ml-1">{group.brands.length}</span>
            </a>
          ))}
        </div>
      </header>

      <div class="space-y-12">
        {brandsByCategory.map(group => (
          <section
            id={group.category.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '')}
            class="scroll-mt-24"
          >
            <div class="grid gap-6 lg:grid-cols-[260px_minmax(0,1fr)] lg:items-start">
              <header class="lg:sticky lg:top-24 space-y-3">
                <div class="space-y-1">
                  <p class="text-xs font-semibold tracking-[0.18em] uppercase text-[var(--color-forest-700)]">
                    {group.brands.length} {group.brands.length === 1 ? 'brand' : 'brands'}
                  </p>
                  <h3 class="text-xl font-display font-bold text-[var(--color-stone-900)]">{group.category}</h3>
                </div>
                <p class="text-sm text-[var(--color-stone-600)] leading-relaxed">{group.description}</p>
              </header>
              <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-5">
                {group.brands.map(brand => (
                  <BrandCard brand={brand} outletCount={brandOutletCount(brand.slug)} />
                ))}
              </div>
            </div>
          </section>
        ))}
      </div>
    </section>

  </div>

</Layout>
