---
import Header from './Header.astro';
import Footer from './Footer.astro';
import SEOHead from './SEOHead.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  image?: string;
  type?: 'website' | 'article';
  canonical?: string;
  noindex?: boolean;
  jsonLd?: object;
  fullWidth?: boolean;
}

const {
  title,
  description,
  image,
  type,
  canonical,
  noindex,
  jsonLd,
  fullWidth = false,
} = Astro.props;
const utilityPages = ['/search/', '/contact/', '/advertise/', '/newsletter/', '/submit-a-review/', '/404/'];
const utilityPage = utilityPages.includes(Astro.url.pathname) || Astro.url.pathname.endsWith('/404.html');
const effectiveNoindex = noindex || utilityPage;
---

<!doctype html>
<html lang="en-SG">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="theme-color" content="#3079C8" />
  <meta name="p:domain_verify" content="98d8f192a7c87901873e5a13ae072c99" />
  {!effectiveNoindex && (
    <script is:inline async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-7471602840772834" crossorigin="anonymous"></script>
  )}
  <link rel="icon" type="image/png" sizes="512x512" href="/favicon.png?v=20260531" />
  <link rel="shortcut icon" href="/favicon.ico?v=20260531" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=20260531" />
  <link rel="manifest" href="/site.webmanifest" />

  <!-- Google Fonts: Playfair Display + Inter -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400;1,600&display=swap"
    rel="stylesheet"
  />

  <SEOHead
    title={title}
    description={description}
    image={image}
    type={type}
    canonical={canonical}
    noindex={effectiveNoindex}
    jsonLd={jsonLd}
  />
</head>
<body class="min-h-screen flex flex-col" data-ad-eligible={effectiveNoindex ? "false" : "true"}>
  <Header />

  <main id="main-content" class={`flex-1 pt-16 lg:pt-18 ${fullWidth ? '' : ''}`} tabindex="-1">
    <slot />
  </main>

  <Footer />

  <!-- Pagefind UI initialisation (no-op in dev; active after build) -->
  <script>
    // Pagefind is loaded dynamically after build; this prevents 404 errors in dev
    if (typeof window !== 'undefined') {
      window.__pagefindReady = false;
    }
  </script>
  <slot name="body-end" />
</body>
</html>
