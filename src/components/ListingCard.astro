---
import type { Outlet } from '../lib/types';

interface Props {
  outlet: Outlet;
  featured?: boolean;
}

const { outlet, featured = false } = Astro.props;

const priceLabels: Record<string, string> = {
  '$':   'Budget-friendly',
  '$$':  'Mid-range',
  '$$$': 'Premium',
};

const priceColors: Record<string, string> = {
  '$':   'text-emerald-700 bg-emerald-50',
  '$$':  'text-[var(--color-boba-500)] bg-[var(--color-blush-100)]',
  '$$$': 'text-[var(--color-taro-500)] bg-[var(--color-taro-400)]/10',
};
---

<article
  class={`group bg-white rounded-2xl overflow-hidden shadow-sm border border-[var(--color-stone-200)] card-lift ${featured ? 'lg:col-span-2' : ''}`}
  data-pagefind-body
>
  <!-- Image -->
  <a href={`/shops/${outlet.slug}`} class="block overflow-hidden aspect-[4/3] bg-[var(--color-cream-100)]" tabindex="-1" aria-hidden="true">
    {outlet.image ? (
      <img
        src={outlet.image}
        alt={`${outlet.name} — ${outlet.brandName} in ${outlet.town}`}
        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
        loading="lazy"
        decoding="async"
        width="600"
        height="450"
      />
    ) : (
      <div class="w-full h-full flex items-center justify-center text-5xl bg-gradient-to-br from-[var(--color-cream-100)] to-[var(--color-cream-200)]">
        🧋
      </div>
    )}
  </a>

  <!-- Card body -->
  <div class="p-5 space-y-3">

    <!-- Brand pill + badges -->
    <div class="flex items-center justify-between gap-2 flex-wrap">
      <a
        href={`/brands/${outlet.brandSlug}`}
        class="inline-flex items-center gap-1.5 text-xs font-semibold tracking-wide text-[var(--color-forest-700)] hover:text-[var(--color-forest-800)] uppercase transition-colors"
      >
        {outlet.brandName}
      </a>
      <div class="flex items-center gap-1.5 flex-wrap">
        {outlet.halalFriendly && (
          <span class="text-[10px] font-semibold px-2 py-0.5 rounded-full bg-green-50 text-green-700 border border-green-200">
            Halal-friendly
          </span>
        )}
        {outlet.priceRange && (
          <span class={`text-[10px] font-semibold px-2 py-0.5 rounded-full ${priceColors[outlet.priceRange] ?? ''}`}
            title={priceLabels[outlet.priceRange]}>
            {outlet.priceRange}
          </span>
        )}
      </div>
    </div>

    <!-- Outlet name -->
    <h3 class="text-base font-display font-semibold text-[var(--color-stone-900)] leading-snug">
      <a href={`/shops/${outlet.slug}`} class="hover:text-[var(--color-forest-700)] transition-colors">
        {outlet.name}
      </a>
    </h3>

    <!-- Location details -->
    <div class="space-y-1.5 text-sm text-[var(--color-stone-600)]">
      <div class="flex items-start gap-1.5">
        <svg class="w-4 h-4 mt-0.5 text-[var(--color-stone-400)] flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
        </svg>
        <span>
          <a href={`/towns/${outlet.townSlug}`} class="font-medium text-[var(--color-stone-700)] hover:text-[var(--color-forest-700)] transition-colors">
            {outlet.town}
          </a>
          {outlet.mall && <> · {outlet.mall}</>}
        </span>
      </div>

      {outlet.nearestMrt && (
        <div class="flex items-center gap-1.5">
          <svg class="w-4 h-4 text-[var(--color-stone-400)] flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
          </svg>
          <a href={`/near-mrt/${outlet.mrtSlug}`} class="hover:text-[var(--color-forest-700)] transition-colors">
            {outlet.nearestMrt} MRT
          </a>
        </div>
      )}
    </div>

    <!-- Popular drinks -->
    {outlet.popularDrinks && outlet.popularDrinks.length > 0 && (
      <div class="flex flex-wrap gap-1.5 pt-1">
        {outlet.popularDrinks.slice(0, 3).map(drink => (
          <span class="text-[11px] font-medium px-2.5 py-1 rounded-full bg-[var(--color-cream-100)] text-[var(--color-stone-600)] border border-[var(--color-cream-200)]">
            {drink}
          </span>
        ))}
        {outlet.popularDrinks.length > 3 && (
          <span class="text-[11px] font-medium px-2.5 py-1 rounded-full bg-[var(--color-cream-100)] text-[var(--color-stone-400)]">
            +{outlet.popularDrinks.length - 3} more
          </span>
        )}
      </div>
    )}

    <!-- View link -->
    <div class="pt-2 border-t border-[var(--color-stone-100)] flex items-center justify-between">
      <a
        href={`/shops/${outlet.slug}`}
        class="text-sm font-semibold text-[var(--color-forest-700)] hover:text-[var(--color-forest-800)] flex items-center gap-1 transition-colors group/link"
      >
        View Details
        <svg class="w-3.5 h-3.5 group-hover/link:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"/>
        </svg>
      </a>
      {outlet.seatingAvailable && (
        <span class="text-[11px] text-[var(--color-stone-400)] flex items-center gap-1">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2"/>
          </svg>
          Seating
        </span>
      )}
    </div>
  </div>
</article>
