---
interface Props {
  placeholder?: string;
  large?: boolean;
  id?: string;
}

const {
  placeholder = 'Search shops, brands, towns, drinks…',
  large = false,
  id = 'search-input',
} = Astro.props;
---

<form
  action="/search"
  method="get"
  role="search"
  class="relative w-full"
>
  <label for={id} class="sr-only">Search bubble tea shops</label>

  <!-- Search icon -->
  <div class="absolute inset-y-0 left-0 flex items-center pointer-events-none" class:list={[large ? 'pl-5' : 'pl-4']}>
    <svg
      class={`text-[var(--color-stone-400)] flex-shrink-0 ${large ? 'w-5 h-5' : 'w-4 h-4'}`}
      fill="none"
      stroke="currentColor"
      viewBox="0 0 24 24"
      aria-hidden="true"
    >
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
    </svg>
  </div>

  <input
    type="search"
    id={id}
    name="q"
    placeholder={placeholder}
    autocomplete="off"
    class={[
      'w-full bg-white border border-[var(--color-stone-200)] rounded-full',
      'text-[var(--color-stone-900)] placeholder:text-[var(--color-stone-400)]',
      'focus:outline-none focus:ring-2 focus:ring-[var(--color-forest-700)] focus:border-transparent',
      'transition',
      large
        ? 'pl-14 pr-32 py-4 text-base shadow-md'
        : 'pl-10 pr-20 py-2.5 text-sm shadow-sm',
    ].join(' ')}
  />

  <button
    type="submit"
    class={[
      'absolute inset-y-0 right-0 flex items-center font-semibold rounded-full bg-[var(--color-forest-700)] text-white hover:bg-[var(--color-forest-800)] transition-colors',
      large ? 'px-6 m-1 text-sm' : 'px-4 m-1 text-xs',
    ].join(' ')}
  >
    Search
  </button>
</form>
