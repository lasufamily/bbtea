---
import type { Brand, Mall, MrtStation, Town } from '../lib/types';

interface Props {
  brands: Brand[];
  towns: Town[];
  malls: Mall[];
  mrtStations: MrtStation[];
  idPrefix?: string;
  selectedTown?: string;
  selectedBrand?: string;
  selectedMall?: string;
  selectedMrt?: string;
  selectedHalal?: string;
}

const {
  brands,
  towns = [],
  malls = [],
  mrtStations = [],
  idPrefix = 'filters',
  selectedTown = '',
  selectedBrand = '',
  selectedMall = '',
  selectedMrt = '',
  selectedHalal = '',
} = Astro.props;

const ids = {
  form: `${idPrefix}-form`,
  town: `${idPrefix}-town`,
  brand: `${idPrefix}-brand`,
  mall: `${idPrefix}-mall`,
  mrt: `${idPrefix}-mrt`,
  halal: `${idPrefix}-halal`,
};
---

<aside aria-label="Filter shops" class="bg-white border border-[var(--color-stone-200)] rounded-lg p-6 space-y-6 sticky top-24 shadow-none">
  <div class="flex items-center justify-between">
    <h2 class="text-sm font-semibold tracking-wide uppercase text-[var(--color-stone-500)]">
      Filter
    </h2>
    <a
      href="/directory/"
      class="text-xs text-[var(--color-forest-700)] hover:underline font-medium"
    >
      Clear all
    </a>
  </div>

  <form id={ids.form} data-filter-form method="get" action="/directory/" class="space-y-5" novalidate>

    <!-- Brand -->
    <div class="space-y-2">
      <label for={ids.brand} class="text-xs font-semibold text-[var(--color-stone-600)] uppercase tracking-wider">
        Brand
      </label>
      <select
        id={ids.brand}
        name="brand"
        class="w-full text-sm rounded-lg border border-[var(--color-stone-200)] bg-white px-3 py-2.5 text-[var(--color-stone-700)] focus:outline-none focus:ring-2 focus:ring-[var(--color-forest-700)] cursor-pointer"
      >
        <option value="">All Brands</option>
        {brands.map(brand => (
          <option value={brand.slug} selected={selectedBrand === brand.slug}>
            {brand.name}
          </option>
        ))}
      </select>
    </div>

    <!-- Town -->
    <div class="space-y-2">
      <label for={ids.town} class="text-xs font-semibold text-[var(--color-stone-600)] uppercase tracking-wider">
        Town
      </label>
      <select
        id={ids.town}
        name="town"
        class="w-full text-sm rounded-lg border border-[var(--color-stone-200)] bg-white px-3 py-2.5 text-[var(--color-stone-700)] focus:outline-none focus:ring-2 focus:ring-[var(--color-forest-700)] cursor-pointer"
      >
        <option value="">All Towns</option>
        {towns.map(town => (
          <option value={town.slug} selected={selectedTown === town.slug}>
            {town.name}
          </option>
        ))}
      </select>
    </div>

    <!-- Mall -->
    <div class="space-y-2">
      <label for={ids.mall} class="text-xs font-semibold text-[var(--color-stone-600)] uppercase tracking-wider">
        Mall
      </label>
      <select
        id={ids.mall}
        name="mall"
        class="w-full text-sm rounded-lg border border-[var(--color-stone-200)] bg-white px-3 py-2.5 text-[var(--color-stone-700)] focus:outline-none focus:ring-2 focus:ring-[var(--color-forest-700)] cursor-pointer"
      >
        <option value="">All Malls</option>
        {malls.map(mall => (
          <option value={mall.slug} selected={selectedMall === mall.slug}>
            {mall.name}
          </option>
        ))}
      </select>
    </div>

    <!-- Nearest MRT -->
    <div class="space-y-2">
      <label for={ids.mrt} class="text-xs font-semibold text-[var(--color-stone-600)] uppercase tracking-wider">
        Nearest MRT
      </label>
      <select
        id={ids.mrt}
        name="mrt"
        class="w-full text-sm rounded-lg border border-[var(--color-stone-200)] bg-white px-3 py-2.5 text-[var(--color-stone-700)] focus:outline-none focus:ring-2 focus:ring-[var(--color-forest-700)] cursor-pointer"
      >
        <option value="">Any MRT</option>
        {mrtStations.map(mrt => (
          <option value={mrt.slug} selected={selectedMrt === mrt.slug}>
            {mrt.name}
          </option>
        ))}
      </select>
    </div>

    <!-- Halal -->
    <div class="flex items-center justify-between">
      <label for={ids.halal} class="text-sm font-medium text-[var(--color-stone-700)] cursor-pointer">
        Halal
      </label>
      <input
        type="checkbox"
        id={ids.halal}
        name="halal"
        value="true"
        checked={selectedHalal === 'true'}
        class="w-4 h-4 rounded accent-[var(--color-forest-700)] cursor-pointer"
      />
    </div>

    <!-- Apply -->
    <button
      type="submit"
      class="w-full py-3 rounded-lg text-sm font-semibold bg-[var(--color-forest-700)] text-white hover:bg-white hover:text-[var(--color-forest-700)] border border-[var(--color-forest-700)] transition-colors mt-2"
    >
      Apply Filters
    </button>
  </form>
</aside>
