---
interface Props {
  show: boolean;
}

const { show } = Astro.props;
---

{show && (
  <aside class="text-sm text-[var(--color-stone-600)] space-y-2" aria-label="itea menu sources">
    <p>This list combines itea's online product series with ordering screenshots checked on 29 November 2026. Prices are in SGD: M is the displayed Medium price, and L includes the listed Large surcharge. Optional extras are excluded. Prices and availability may vary by outlet.</p>
    <p>Nutri-Grade follows the pictured drink in the ordering screenshots, or the official product image where no matching screenshot was supplied. The grade may differ with preparation. Calories and cup volumes were not provided. Prices remain unlisted where a matching drink could not be verified.</p>
    <p>
      <a href="https://itea.sg/menu/our-signatures" class="underline" target="_blank" rel="noopener noreferrer">Signatures</a>
      <span aria-hidden="true"> · </span>
      <a href="https://itea.sg/menu/fresh-milk-tea" class="underline" target="_blank" rel="noopener noreferrer">Fresh milk tea</a>
      <span aria-hidden="true"> · </span>
      <a href="https://itea.sg/menu/fruit-tea" class="underline" target="_blank" rel="noopener noreferrer">Fruit tea</a>
    </p>
  </aside>
)}
