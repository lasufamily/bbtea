---
const navLinks = [
  { href: '/directory', label: 'Directory' },
  { href: '/towns',     label: 'Towns' },
  { href: '/malls',     label: 'Malls' },
  { href: '/drinks',    label: 'Drink Types' },
  { href: '/brands',    label: 'Brands' },
  { href: '/blog',      label: 'Blog' },
  { href: '/search',    label: 'Search' },
];

const pathname = Astro.url.pathname;
---

<header
  id="site-header"
  class="fixed inset-x-0 top-0 z-50 transition-all duration-300"
  data-header
>
  <div class="absolute inset-0 bg-white/95 backdrop-blur-md border-b border-[var(--color-stone-200)]"></div>

  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16 lg:h-18">

      <!-- Logo -->
      <a href="/" class="flex items-center gap-2.5 group" aria-label="Bubble Tea SG home">
        <span class="text-lg font-display font-semibold tracking-tight text-[var(--color-stone-900)] group-hover:text-[var(--color-forest-700)] transition-colors">
          Bubble Tea <span class="text-[var(--color-forest-700)]">SG</span>
        </span>
      </a>

      <!-- Desktop nav -->
      <nav class="hidden lg:flex items-center gap-8" aria-label="Main navigation">
        {navLinks.map(link => (
          <a
            href={link.href}
            class={[
              'text-sm font-medium tracking-wide link-underline transition-colors',
              pathname.startsWith(link.href.split('/').slice(0, 2).join('/'))
                ? 'text-[var(--color-forest-700)]'
                : 'text-[var(--color-stone-600)] hover:text-[var(--color-stone-900)]',
            ].join(' ')}
          >
            {link.label}
          </a>
        ))}
      </nav>

      <!-- CTA + mobile toggle -->
      <div class="flex items-center gap-3">
        <a
          href="/directory"
          class="hidden sm:inline-flex items-center px-4 py-2 text-sm font-medium rounded-lg border border-[var(--color-stone-900)] bg-[var(--color-stone-900)] text-white hover:bg-white hover:text-[var(--color-stone-900)] transition-colors"
        >
          Explore All
        </a>

        <!-- Mobile hamburger -->
        <button
          id="mobile-menu-btn"
          type="button"
          class="lg:hidden p-2 rounded-md text-[var(--color-stone-600)] hover:text-[var(--color-stone-900)] hover:bg-[var(--color-stone-100)] transition-colors"
          aria-expanded="false"
          aria-controls="mobile-menu"
          aria-label="Toggle navigation menu"
        >
          <svg id="icon-open"  class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>
          <svg id="icon-close" class="w-5 h-5 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile menu -->
  <div
    id="mobile-menu"
    class="hidden lg:hidden absolute inset-x-0 top-full bg-white border-b border-[var(--color-stone-200)] shadow-none"
  >
    <nav class="max-w-7xl mx-auto px-4 py-4 flex flex-col gap-1" aria-label="Mobile navigation">
      {navLinks.map(link => (
        <a
          href={link.href}
          class="px-4 py-3 rounded-lg text-sm font-medium text-[var(--color-stone-700)] hover:bg-[var(--color-cream-100)] hover:text-[var(--color-forest-700)] transition-colors"
        >
          {link.label}
        </a>
      ))}
      <div class="pt-3 mt-1 border-t border-[var(--color-stone-200)]">
        <a
          href="/directory"
          class="block w-full text-center px-4 py-3 rounded-lg text-sm font-medium bg-[var(--color-stone-900)] text-white hover:bg-white hover:text-[var(--color-stone-900)] border border-[var(--color-stone-900)] transition-colors"
        >
          Explore All Shops
        </a>
      </div>
    </nav>
  </div>
</header>

<script>
  const btn  = document.getElementById('mobile-menu-btn')!;
  const menu = document.getElementById('mobile-menu')!;
  const iconOpen  = document.getElementById('icon-open')!;
  const iconClose = document.getElementById('icon-close')!;

  btn.addEventListener('click', () => {
    const isOpen = menu.classList.toggle('hidden');
    btn.setAttribute('aria-expanded', String(!isOpen));
    iconOpen.classList.toggle('hidden',  !isOpen);
    iconClose.classList.toggle('hidden', isOpen);
  });

  // Close on route change / link click
  menu.querySelectorAll('a').forEach(a => {
    a.addEventListener('click', () => {
      menu.classList.add('hidden');
      btn.setAttribute('aria-expanded', 'false');
      iconOpen.classList.remove('hidden');
      iconClose.classList.add('hidden');
    });
  });
</script>
