---
import type { Brand } from '../lib/types';

interface Props {
  brand: Brand;
  outletCount?: number;
}

const { brand, outletCount = 0 } = Astro.props;
---

<article class="group bg-white rounded-2xl overflow-hidden border border-[var(--color-stone-200)] card-lift shadow-sm">
  <a href={`/brands/${brand.slug}`} class="block p-6 space-y-4" data-pagefind-body>

    <!-- Logo / Icon -->
    <div class="flex items-start justify-between gap-4">
      <div class="w-14 h-14 rounded-xl overflow-hidden bg-[var(--color-cream-100)] flex-shrink-0 border border-[var(--color-stone-200)]">
        {brand.logo ? (
          <img
            src={brand.logo}
            alt={`${brand.name} logo`}
            class="w-full h-full object-cover"
            loading="lazy"
            decoding="async"
            width="56"
            height="56"
          />
        ) : (
          <div class="w-full h-full flex items-center justify-center text-2xl">🧋</div>
        )}
      </div>
      {brand.featured && (
        <span class="text-[10px] font-bold tracking-widest uppercase px-2 py-1 rounded-full bg-[var(--color-boba-400)]/10 text-[var(--color-boba-500)]">
          Featured
        </span>
      )}
    </div>

    <!-- Name & description -->
    <div class="space-y-2">
      <h3 class="text-base font-display font-semibold text-[var(--color-stone-900)] group-hover:text-[var(--color-forest-700)] transition-colors leading-snug">
        {brand.name}
      </h3>
      {brand.description && (
        <p class="text-sm text-[var(--color-stone-600)] leading-relaxed line-clamp-2">
          {brand.description}
        </p>
      )}
    </div>

    <!-- Meta -->
    <div class="flex items-center justify-between pt-2 border-t border-[var(--color-stone-100)]">
      <span class="text-xs text-[var(--color-stone-400)]">
        {outletCount} {outletCount === 1 ? 'outlet' : 'outlets'} in Singapore
      </span>
      <span class="text-sm font-semibold text-[var(--color-forest-700)] flex items-center gap-1 group-hover:gap-1.5 transition-all">
        View
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"/>
        </svg>
      </span>
    </div>
  </a>
</article>
