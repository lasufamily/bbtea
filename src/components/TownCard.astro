---
import type { Town } from '../lib/types';

interface Props {
  town: Town;
  outletCount?: number;
}

const { town, outletCount = 0 } = Astro.props;

// Fallback gradient colours per town for visual variety
const gradients: Record<string, string> = {
  'orchard':    'from-rose-100 to-pink-50',
  'bugis':      'from-amber-100 to-yellow-50',
  'chinatown':  'from-red-100 to-orange-50',
  'tampines':   'from-sky-100 to-blue-50',
  'woodlands':  'from-green-100 to-emerald-50',
  'jurong-east':'from-violet-100 to-purple-50',
  'bedok':      'from-teal-100 to-cyan-50',
  'punggol':    'from-lime-100 to-green-50',
  'ang-mo-kio': 'from-orange-100 to-amber-50',
  'bishan':     'from-indigo-100 to-blue-50',
  'clementi':   'from-fuchsia-100 to-pink-50',
  'serangoon':  'from-cyan-100 to-teal-50',
  'toa-payoh':  'from-yellow-100 to-amber-50',
};

const gradient = gradients[town.slug] ?? 'from-[var(--color-cream-100)] to-[var(--color-cream-200)]';
---

<article class="group bg-white rounded-2xl overflow-hidden border border-[var(--color-stone-200)] card-lift shadow-sm">
  <a href={`/towns/${town.slug}`} class="block" data-pagefind-body>

    <!-- Colour swatch top -->
    <div class={`h-20 bg-gradient-to-br ${gradient} flex items-end p-4`}>
      <span class="text-3xl" aria-hidden="true">📍</span>
    </div>

    <div class="p-5 space-y-2">
      <h3 class="text-base font-display font-semibold text-[var(--color-stone-900)] group-hover:text-[var(--color-forest-700)] transition-colors">
        {town.name}
      </h3>

      {town.description && (
        <p class="text-sm text-[var(--color-stone-600)] leading-relaxed line-clamp-2">
          {town.description}
        </p>
      )}

      <div class="flex items-center justify-between pt-3 border-t border-[var(--color-stone-100)]">
        <span class="text-xs text-[var(--color-stone-400)]">
          {outletCount} {outletCount === 1 ? 'shop' : 'shops'}
        </span>
        <span class="text-sm font-semibold text-[var(--color-forest-700)] flex items-center gap-1 group-hover:gap-1.5 transition-all">
          Explore
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"/>
          </svg>
        </span>
      </div>
    </div>
  </a>
</article>
