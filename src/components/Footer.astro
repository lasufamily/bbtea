---
import { getCoffeeOutlets, getJuiceOutlets, getOutlets } from '../lib/airtable';

const year = new Date().getFullYear();
const [outlets, coffeeOutlets, juiceOutlets] = await Promise.all([getOutlets(), getCoffeeOutlets(), getJuiceOutlets()]);
const brandCounts = new Map<string, { href: string; label: string; count: number }>();

for (const outlet of [...outlets, ...coffeeOutlets, ...juiceOutlets]) {
  if (!outlet.brandSlug || !outlet.brandName) continue;

  const current = brandCounts.get(outlet.brandSlug);
  brandCounts.set(outlet.brandSlug, {
    href: `/brands/${outlet.brandSlug}/`,
    label: outlet.brandName,
    count: (current?.count ?? 0) + 1,
  });
}

const popularBrandLinks = Array.from(brandCounts.values())
  .sort((a, b) => b.count - a.count || a.label.localeCompare(b.label))
  .slice(0, 10)
  .map(({ href, label }) => ({ href, label }));

const footerLinks = {
  'About': [
    { href: '/about/',      label: 'About' },
    { href: '/contact/',    label: 'Contact' },
    { href: '/advertise/',  label: 'Advertise' },
    { href: '/newsletter/', label: 'Newsletter' },
  ],
  'Directories': [
    { href: '/directory/',        label: 'All Shops' },
    { href: '/bubble-tea-shops/', label: 'Bubble Tea Shops' },
    { href: '/coffee-shops/',     label: 'Coffee Shops' },
    { href: '/juice-shops/',      label: 'Juice Shops' },
    { href: '/towns/',            label: 'Singapore Towns' },
    { href: '/brands/',           label: 'Brands' },
    { href: '/stations/',         label: 'MRT Stations' },
    { href: '/malls/',            label: 'Malls' },
    { href: '/halal/',            label: 'Halal' },
    { href: '/drinks/',           label: 'Drinks' },
  ],
  'Resources': [
    { href: '/reviews/', label: 'Reviews' },
    { href: '/menus/',   label: 'Menus' },
    { href: '/faq/',     label: 'FAQ' },
    { href: '/blog/',    label: 'Blog' },
  ],
  'Popular Brands': popularBrandLinks,
};
---

<footer class="bg-white text-[var(--color-stone-900)] border-t border-[var(--color-stone-200)]">
  <!-- Top section -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-16 pb-12">
    <div class="grid grid-cols-1 lg:grid-cols-6 gap-10">

      <!-- Brand column -->
      <div class="lg:col-span-2 space-y-5">
        <a href="/" class="inline-flex items-center" aria-label="BBTea.sg home">
          <img
            src="/bbtea-logo.png"
            alt="BBTea.sg"
            class="h-auto w-36 transition-opacity hover:opacity-80 sm:w-44"
            width="1400"
            height="700"
            decoding="async"
            loading="lazy"
          />
        </a>
        <p class="text-sm text-[var(--color-stone-600)] leading-relaxed max-w-sm">
          A practical guide to bubble tea, coffee and juice shops across Singapore, from Orchard
          to Woodlands.
        </p>
        <div class="flex gap-4 pt-1">
          <a href="/search/" class="inline-flex items-center gap-1.5 text-sm font-medium text-[var(--color-stone-600)] hover:text-[var(--color-forest-700)] transition-colors">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
            Search
          </a>
        </div>
      </div>

      <!-- Link columns -->
      {Object.entries(footerLinks).map(([heading, links]) => (
        <div>
          <h3 class="text-xs font-semibold tracking-widest uppercase text-[var(--color-stone-400)] mb-4">
            {heading}
          </h3>
          <ul class="space-y-2.5">
            {links.map(link => (
              <li>
                <a
                  href={link.href}
                  class="text-sm text-[var(--color-stone-600)] hover:text-[var(--color-forest-700)] transition-colors link-underline"
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>

  <!-- Bottom bar -->
  <div class="border-t border-[var(--color-stone-200)]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 flex flex-col sm:flex-row items-center justify-between gap-3">
      <p class="text-xs text-[var(--color-stone-500)]">
        © {year} BBTea.sg. All rights reserved. · Singapore
      </p>
      <div class="flex items-center gap-4 text-xs text-[var(--color-stone-500)]">
        <a href="/privacy/" class="hover:text-[var(--color-forest-700)] transition-colors">Privacy Policy</a>
        <a href="/terms/" class="hover:text-[var(--color-forest-700)] transition-colors">Terms of Service</a>
      </div>
    </div>
  </div>
</footer>
