---
import { getCategories, getOutlets, getTowns } from '../lib/airtable';
import { getTownsFromOutlets } from '../lib/towns';

const year = new Date().getFullYear();
const [outlets, allTowns, categories] = await Promise.all([getOutlets(), getTowns(), getCategories()]);
const popularTownLinks = getTownsFromOutlets(outlets, allTowns).slice(0, 5).map(town => ({
  href: `/towns/${town.slug}`,
  label: town.name,
}));

const footerLinks = {
  'Browse': [
    { href: '/directory',  label: 'All Shops' },
    { href: '/towns',      label: 'Towns' },
    { href: '/menus',      label: 'Menus' },
    { href: '/drinks',     label: 'Drinks' },
    { href: '/brands',     label: 'Brands' },
    { href: '/stations',   label: 'Near MRT' },
    { href: '/halal',      label: 'Halal-Friendly' },
    { href: '/malls',      label: 'By Mall' },
    { href: '/catering',   label: 'Catering' },
    { href: '/blog',       label: 'Blog' },
  ],
  'Popular Towns': popularTownLinks,
  'Drink Categories': categories.slice(0, 5).map(category => ({
    href: `/drinks?category=${category.slug}`,
    label: category.name,
  })),
};
---

<footer class="bg-white text-[var(--color-stone-900)] border-t border-[var(--color-stone-200)]">
  <!-- Top section -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-16 pb-12">
    <div class="grid grid-cols-1 lg:grid-cols-5 gap-10">

      <!-- Brand column -->
      <div class="lg:col-span-2 space-y-5">
        <a href="/" class="inline-flex items-center" aria-label="BBTea.sg home">
          <img
            src="/bbtea-logo.png"
            alt="BBTea.sg"
            class="h-auto w-36 transition-opacity hover:opacity-80 sm:w-44"
            width="1400"
            height="700"
            decoding="async"
            loading="lazy"
          />
        </a>
        <p class="text-sm text-[var(--color-stone-600)] leading-relaxed max-w-sm">
          Singapore's most comprehensive bubble tea directory — discover the best
          boba shops across the island, from Orchard to Woodlands.
        </p>
        <div class="flex gap-4 pt-1">
          <a href="/search" class="inline-flex items-center gap-1.5 text-sm font-medium text-[var(--color-stone-600)] hover:text-[var(--color-stone-900)] transition-colors">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
            Search
          </a>
        </div>
      </div>

      <!-- Link columns -->
      {Object.entries(footerLinks).map(([heading, links]) => (
        <div>
          <h3 class="text-xs font-semibold tracking-widest uppercase text-[var(--color-stone-400)] mb-4">
            {heading}
          </h3>
          <ul class="space-y-2.5">
            {links.map(link => (
              <li>
                <a
                  href={link.href}
                  class="text-sm text-[var(--color-stone-600)] hover:text-[var(--color-stone-900)] transition-colors link-underline"
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>

  <!-- Bottom bar -->
  <div class="border-t border-[var(--color-stone-200)]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 flex flex-col sm:flex-row items-center justify-between gap-3">
      <p class="text-xs text-[var(--color-stone-500)]">
        © {year} BBTea.sg. All rights reserved. · Singapore
      </p>
      <div class="flex items-center gap-4 text-xs text-[var(--color-stone-500)]">
        <a href="/privacy" class="hover:text-[var(--color-stone-900)] transition-colors">Privacy Policy</a>
        <a href="/terms" class="hover:text-[var(--color-stone-900)] transition-colors">Terms of Service</a>
      </div>
    </div>
  </div>
</footer>
